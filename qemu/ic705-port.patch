+    timer_mod(s->ic705_sub_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + IC705_SUB_PERIOD_NS);
+}
+
+void rza1h_scif_set_tx_hook(DeviceState *dev, void (*fn)(void *, uint8_t), void *opaque)
+{
+    RZA1HScifState *s = RZA1H_SCIF(dev);
+    s->tx_hook = fn;
+    s->tx_hook_opaque = opaque;
+}
+
+void rza1h_scif_get_mode(DeviceState *dev, uint16_t *smr, uint16_t *scr, int *rxq)
+{
+    RZA1HScifState *s = RZA1H_SCIF(dev);
