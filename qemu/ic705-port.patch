+/* Sub-CPU status frame, as the ARM's SCIF3 RXI handler (0x20120CAC) parses it:
+ *   FC <offset> <data...> FE ; bytes 0xFB..0xFF in the body are sent as FF,(b+16).
+ * The data lands in a 54-byte status mirror at offset. Content is unknown so far: zeros,
+ * overridable byte-by-byte via RZA1H_IC705_SUBSTAT="hexbytes". */
+#define IC705_SUB_PERIOD_NS 10000000
+static void rza1h_ic705_sub_tick(void *opaque)
+{
+    RZA1HScifState *s = opaque;
+    uint8_t f[2 + 2 * 55 + 1];
+    int n = 0;
+
+    if ((s->scr & SCR_RE) && s->inj_head == s->inj_tail && !s->rx_pending) {
+        const char *e = getenv("RZA1H_IC705_SUBSTAT");
+        if (e) {
+            for (int i = 0; i < 54 && e[2 * i] && e[2 * i + 1]; i++) {
+                char h[3] = { e[2 * i], e[2 * i + 1], 0 };
+                s->ic705_status[i] = strtoul(h, NULL, 16);
+            }
+        }
+        f[n++] = 0xFC;
+        for (int i = -1; i < 54; i++) {
+            uint8_t b = i < 0 ? 0 : s->ic705_status[i];
+            if (b >= 0xFB) {
+                f[n++] = 0xFF;
+                f[n++] = b + 16;
+            } else {
+                f[n++] = b;
+            }
+        }
+        f[n++] = 0xFE;
+        rza1h_debug("scif3", "ic705 sub-cpu: status frame (%d bytes)", n);
+        rza1h_scif_inj_push(s, f, n);
+    }
+    timer_mod(s->ic705_sub_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + IC705_SUB_PERIOD_NS);
+}
