diff --git a/qemu-machine/src/stm32l0.c b/qemu-machine/src/stm32l0.c
new file mode 100644
index 0000000..f1c7906
--- /dev/null
+++ b/qemu-machine/src/stm32l0.c
@@ -0,0 +1,1202 @@
+/*
+ * STM32L0 (Cortex-M0+) SoC model -- the IC-705 sub-CPU ("ICOM4075S"), IC-705 port.
+ *
+ * Runs the sub-CPU firmware image from the .dat (aux2, 64 KiB at 0x08000000) on its own
+ * Cortex-M0 core (separate CPU cluster and address space), next to the RZ/A1H.
+ * Peripheral set and addresses follow the STM32L0x2/x3 reference manual, limited to what
+ * that firmware touches (found by literal-pool scan of aux2):
+ *
+ *   RCC 0x40021000  PWR 0x40007000  FLASH 0x40022000  IWDG 0x40003000
+ *   GPIOA..D,H 0x50000000.. (IOPORT)  SYSCFG 0x40010000  EXTI 0x40010400
+ *   TIM2 0x40000000  TIM6 0x40001000  TIM21 0x40010800  TIM22 0x40011400
+ *   ADC 0x40012400  SPI1 0x40013000  USART1 0x40013800  DMA1 0x40020000
+ *
+ * Register-level: writes are stored, status flags move as the reference manual says,
+ * interrupts reach the NVIC at the L0 vector numbers. Unlisted peripheral space is a
+ * logged unimplemented region. External connections:
+ *   - USART1 TX bytes -> board hook; board bytes -> stm32l0_usart_rx().
+ *   - GPIO: qdev inputs "pa".."ph" (16 each) and outputs "pa-out".."ph-out".
+ *   - ADC channel values: RZA1H_SUB_ADC="v0,v1,..." (12-bit), default mid-scale except the
+ *     key ladders (ch 0/1/14/15 = 0xFFF, no key); QOM "adc" = "ch=val,..." sets them live.
+ *     Conversions honour CFGR1.RES (the firmware uses 10-bit).
+ *   - SPI1: the attached device is not identified; MISO idles 0xFF.
+ * Debug: RZA1H_DEBUG=sub.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/loader.h"
+#include "hw/arm/armv7m.h"
+#include "hw/cpu/cluster.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+#include "system/reset.h"
+#include "target/arm/cpu.h"
+#include "qom/object.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+#include "stm32l0.h"
+
+#define FLASH_BASE  0x08000000
+#define FLASH_SIZE  0x10000
+#define SRAM_BASE   0x20000000
+#define SRAM_SIZE   0x2000
+#define EEPROM_BASE 0x08080000
+#define EEPROM_SIZE 0x800
+
+enum { IRQ_EXTI0_1 = 5, IRQ_EXTI2_3 = 6, IRQ_EXTI4_15 = 7, IRQ_DMA1 = 9, IRQ_DMA2_3 = 10,
+       IRQ_DMA4_7 = 11, IRQ_ADC = 12, IRQ_TIM2 = 15, IRQ_TIM6 = 17, IRQ_TIM21 = 20,
+       IRQ_TIM22 = 22, IRQ_SPI1 = 25, IRQ_USART1 = 27 };
+
+#define NPORT 5
+static const char port_letter[NPORT] = { 'A', 'B', 'C', 'D', 'H' };
+static const int port_exti_code[NPORT] = { 0, 1, 2, 3, 5 };
+
+/* peripheral blocks inside the 0x40000000..0x50002000 window */
+enum { P_TIM2, P_TIM6, P_IWDG, P_PWR, P_SYSCFG, P_EXTI, P_TIM21, P_TIM22, P_ADC, P_SPI1,
+       P_USART1, P_DMA1, P_RCC, P_FLASH, P_GPIOA, P_GPIOB, P_GPIOC, P_GPIOD, P_GPIOH, P_NONE };
+static const struct { uint32_t base; int id; } pmap[] = {
+    { 0x40000000, P_TIM2 }, { 0x40001000, P_TIM6 }, { 0x40003000, P_IWDG },
+    { 0x40007000, P_PWR }, { 0x40010000, P_SYSCFG }, { 0x40010400, P_EXTI },
+    { 0x40010800, P_TIM21 }, { 0x40011400, P_TIM22 }, { 0x40012400, P_ADC },
+    { 0x40013000, P_SPI1 }, { 0x40013800, P_USART1 }, { 0x40020000, P_DMA1 },
+    { 0x40021000, P_RCC }, { 0x40022000, P_FLASH }, { 0x50000000, P_GPIOA },
+    { 0x50000400, P_GPIOB }, { 0x50000800, P_GPIOC }, { 0x50000C00, P_GPIOD },
+    { 0x50001C00, P_GPIOH },
+};
+
+typedef struct L0Tim {
+    struct STM32L0State *soc;
+    const char *name;
+    int irq, apb;
+    uint32_t cr1, cr2, smcr, dier, sr, ccmr1, ccmr2, ccer, psc, arr, ccr[4];
+    uint32_t base_cnt;
+    int64_t base_ns;
+    QEMUTimer *timer;
+} L0Tim;
+
+struct STM32L0State {
+    SysBusDevice parent_obj;
+    CPUClusterState cluster;
+    ARMv7MState armv7m;
+    MemoryRegion container, flash, flash_alias, sram, eeprom, periph, iop, sysmem_rom;
+    Clock *sysclk, *refclk;
+    char *fw_path;
+
+    uint32_t rcc[0x60 / 4];
+    uint32_t pwr_cr, pwr_csr;
+    uint32_t fl_acr, fl_pecr, fl_sr, fl_optr;
+    uint32_t syscfg[0x24 / 4];
+    uint32_t exti_imr, exti_emr, exti_rtsr, exti_ftsr, exti_pr;
+
+    uint32_t moder[NPORT], otyper[NPORT], ospeedr[NPORT], pupdr[NPORT], odr[NPORT],
+             afr[NPORT][2], ext_in[NPORT], ext_driven[NPORT], last_idr[NPORT];
+    qemu_irq gpio_out[NPORT][16];
+
+    L0Tim tim[4];   /* TIM2, TIM6, TIM21, TIM22 */
+
+    uint32_t adc_isr, adc_ier, adc_cr, adc_cfgr1, adc_cfgr2, adc_smpr, adc_chselr, adc_dr,
+             adc_ccr;
+    uint16_t adc_val[19];
+
+    uint32_t dma_isr, dma_ccr[7], dma_cndtr[7], dma_cpar[7], dma_cmar[7], dma_cselr,
+             dma_cnt0[7], dma_pos[7];
+
+    uint32_t spi_cr1, spi_cr2, spi_rxbuf, spi_txbuf;
+    bool spi_rxne, spi_txfull;
+
+    uint32_t us_cr1, us_cr2, us_cr3, us_brr, us_isr, us_rdr;
+    uint8_t us_rxq[512];
+    int us_rx_head, us_rx_tail;
+    QEMUTimer *us_rx_timer;
+    void (*usart_tx_hook)(void *opaque, uint8_t b);
+    void *usart_tx_opaque;
+};
+
+static void sdebug(const char *fmt, ...) G_GNUC_PRINTF(1, 2);
+static void sdebug(const char *fmt, ...)
+{
+    va_list ap;
+    if (!rza1h_debug_enabled("sub")) {
+        return;
+    }
+    va_start(ap, fmt);
+    fprintf(stderr, "[sub] ");
+    vfprintf(stderr, fmt, ap);
+    fprintf(stderr, "\n");
+    va_end(ap);
+}
+
+static qemu_irq nvic(STM32L0State *s, int n)
+{
+    return qdev_get_gpio_in(DEVICE(&s->armv7m), n);
+}
+
+/* ---------------------------------------------------------------- clocks */
+static uint64_t sysclk_hz(STM32L0State *s)
+{
+    uint32_t cfgr = s->rcc[0x0C / 4];
+    static const int mul[16] = { 3, 4, 6, 8, 12, 16, 24, 32, 48, 3, 3, 3, 3, 3, 3, 3 };
+
+    switch ((cfgr >> 2) & 3) {           /* SWS */
+    case 0:  return 65536ULL << ((s->rcc[0x04 / 4] >> 13) & 7);   /* MSI */
+    case 1:  return 16000000;                                     /* HSI16 */
+    case 2:  return 16000000;            /* HSE: board crystal unknown, 16 MHz assumed */
+    default: return 16000000ULL * mul[(cfgr >> 18) & 15] / (((cfgr >> 22) & 3) + 1);
+    }
+}
+
+static uint64_t timclk_hz(STM32L0State *s, int apb)
+{
+    static const int ahb[16] = { 1, 1, 1, 1, 1, 1, 1, 1, 2, 4, 8, 16, 64, 128, 256, 512 };
+    static const int apbd[8] = { 1, 1, 1, 1, 2, 4, 8, 16 };
+    uint32_t cfgr = s->rcc[0x0C / 4];
+    uint64_t h = sysclk_hz(s) / ahb[(cfgr >> 4) & 15];
+    int p = apbd[(cfgr >> (apb == 1 ? 8 : 11)) & 7];
+    return p > 1 ? h / p * 2 : h;
+}
+
+/* ---------------------------------------------------------------- GPIO / EXTI */
+static uint32_t gpio_idr(STM32L0State *s, int p)
+{
+    uint32_t v = 0;
+    for (int b = 0; b < 16; b++) {
+        int mode = (s->moder[p] >> (2 * b)) & 3, pupd = (s->pupdr[p] >> (2 * b)) & 3, lvl;
+        if (mode == 1) {
+            lvl = (s->odr[p] >> b) & 1;
+        } else if (s->ext_driven[p] & (1u << b)) {
+            lvl = (s->ext_in[p] >> b) & 1;
+        } else {
+            lvl = pupd == 1;
+        }
+        v |= (uint32_t)lvl << b;
+    }
+    return v;
+}
+
+static void exti_update_irq(STM32L0State *s)
+{
+    uint32_t p = s->exti_pr & s->exti_imr;
+    qemu_set_irq(nvic(s, IRQ_EXTI0_1), (p & 0x0003) != 0);
+    qemu_set_irq(nvic(s, IRQ_EXTI2_3), (p & 0x000C) != 0);
+    qemu_set_irq(nvic(s, IRQ_EXTI4_15), (p & 0xFFF0) != 0);
+}
+
+static void gpio_check_edges(STM32L0State *s, int p)
+{
+    uint32_t now = gpio_idr(s, p), ch = now ^ s->last_idr[p];
+    s->last_idr[p] = now;
+    for (int b = 0; b < 16; b++) {
+        if (!(ch & (1u << b))) {
+            continue;
+        }
+        int sel = (s->syscfg[(0x08 + 4 * (b / 4)) / 4] >> (4 * (b % 4))) & 15;
+        bool rise = now & (1u << b);
+        if (sel == port_exti_code[p] &&
+            ((rise && (s->exti_rtsr & (1u << b))) || (!rise && (s->exti_ftsr & (1u << b))))) {
+            s->exti_pr |= 1u << b;
+            sdebug("EXTI%d %s (P%c%d)", b, rise ? "rise" : "fall", port_letter[p], b);
+        }
+    }
+    exti_update_irq(s);
+}
+
+static void gpio_set_odr(STM32L0State *s, int p, uint32_t v)
+{
+    uint32_t ch = (s->odr[p] ^ v) & 0xFFFF;
+    s->odr[p] = v & 0xFFFF;
+    for (int b = 0; b < 16; b++) {
+        if (ch & (1u << b)) {
+            qemu_set_irq(s->gpio_out[p][b], (v >> b) & 1);
+            sdebug("P%c%d out %d", port_letter[p], b, (v >> b) & 1);
+        }
+    }
+    gpio_check_edges(s, p);
+}
+
+static void gpio_in_set(STM32L0State *s, int p, int b, int level)
+{
+    s->ext_driven[p] |= 1u << b;
+    if (level) {
+        s->ext_in[p] |= 1u << b;
+    } else {
+        s->ext_in[p] &= ~(1u << b);
+    }
+    gpio_check_edges(s, p);
+}
+
+#define GPIO_IN_FN(n, idx) \
+    static void gpio_in_##n(void *o, int b, int l) { gpio_in_set(o, idx, b, l); }
+GPIO_IN_FN(a, 0)
+GPIO_IN_FN(b, 1)
+GPIO_IN_FN(c, 2)
+GPIO_IN_FN(d, 3)
+GPIO_IN_FN(h, 4)
+
+void stm32l0_set_pin(STM32L0State *s, char port, int bit, int level)
+{
+    for (int p = 0; p < NPORT; p++) {
+        if (port_letter[p] == port) {
+            gpio_in_set(s, p, bit, level);
+        }
+    }
+}
+
+uint32_t stm32l0_get_odr(STM32L0State *s, char port)
+{
+    for (int p = 0; p < NPORT; p++) {
+        if (port_letter[p] == port) {
+            return s->odr[p];
+        }
+    }
+    return 0;
+}
+
+static uint64_t gpio_read(STM32L0State *s, int p, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return s->moder[p];
+    case 0x04: return s->otyper[p];
+    case 0x08: return s->ospeedr[p];
+    case 0x0C: return s->pupdr[p];
+    case 0x10: return gpio_idr(s, p);
+    case 0x14: return s->odr[p];
+    case 0x20: return s->afr[p][0];
+    case 0x24: return s->afr[p][1];
+    default:   return 0;
+    }
+}
+
+static void gpio_write(STM32L0State *s, int p, hwaddr o, uint32_t v)
+{
+    switch (o) {
+    case 0x00: s->moder[p] = v; gpio_check_edges(s, p); break;
+    case 0x04: s->otyper[p] = v; break;
+    case 0x08: s->ospeedr[p] = v; break;
+    case 0x0C: s->pupdr[p] = v; gpio_check_edges(s, p); break;
+    case 0x14: gpio_set_odr(s, p, v); break;
+    case 0x18: gpio_set_odr(s, p, (s->odr[p] | (v & 0xFFFF)) & ~(v >> 16)); break;
+    case 0x20: s->afr[p][0] = v; break;
+    case 0x24: s->afr[p][1] = v; break;
+    case 0x28: gpio_set_odr(s, p, s->odr[p] & ~(v & 0xFFFF)); break;
+    }
+}
+
+/* ---------------------------------------------------------------- DMA1 */
+static void dma_update_irq(STM32L0State *s)
+{
+    uint32_t act = 0;
+    for (int c = 0; c < 7; c++) {
+        if (((s->dma_isr >> (4 * c)) & 0xE) & (s->dma_ccr[c] & 0xE)) {
+            act |= 1u << c;
+        }
+    }
+    qemu_set_irq(nvic(s, IRQ_DMA1), act & 1);
+    qemu_set_irq(nvic(s, IRQ_DMA2_3), (act & 0x06) != 0);
+    qemu_set_irq(nvic(s, IRQ_DMA4_7), (act & 0x78) != 0);
+}
+
+static void dma_item_done(STM32L0State *s, int c)
+{
+    s->dma_pos[c]++;
+    s->dma_cndtr[c]--;
+    if (s->dma_cndtr[c] == s->dma_cnt0[c] / 2) {
+        s->dma_isr |= 0x5u << (4 * c);            /* HTIF + GIF */
+    }
+    if (s->dma_cndtr[c] == 0) {
+        s->dma_isr |= 0x3u << (4 * c);            /* TCIF + GIF */
+        if (s->dma_ccr[c] & 0x20) {               /* CIRC */
+            s->dma_cndtr[c] = s->dma_cnt0[c];
+            s->dma_pos[c] = 0;
+        }
+    }
+    dma_update_irq(s);
+}
+
+static hwaddr dma_maddr(STM32L0State *s, int c)
+{
+    uint32_t ccr = s->dma_ccr[c];
+    return s->dma_cmar[c] + ((ccr & 0x80) ? s->dma_pos[c] * (1u << ((ccr >> 10) & 3)) : 0);
+}
+
+/* peripheral -> memory, one item; returns false if the channel can't take it */
+static bool dma_put(STM32L0State *s, int c, uint32_t value)
+{
+    uint32_t ccr = s->dma_ccr[c];
+    if (!(ccr & 1) || (ccr & 0x10) || s->dma_cndtr[c] == 0) {
+        return false;
+    }
+    unsigned msz = 1u << ((ccr >> 10) & 3);
+    uint8_t buf[4] = { value, value >> 8, value >> 16, value >> 24 };
+    AddressSpace *as = cpu_get_address_space(CPU(s->armv7m.cpu), 0);
+    address_space_write(as, dma_maddr(s, c), MEMTXATTRS_UNSPECIFIED, buf, msz);
+    dma_item_done(s, c);
+    return true;
+}
+
+/* memory -> peripheral, one item; returns false if nothing pending */
+static bool dma_get(STM32L0State *s, int c, uint32_t *value)
+{
+    uint32_t ccr = s->dma_ccr[c];
+    if (!(ccr & 1) || !(ccr & 0x10) || s->dma_cndtr[c] == 0) {
+        return false;
+    }
+    unsigned msz = 1u << ((ccr >> 10) & 3);
+    uint8_t buf[4] = { 0 };
+    AddressSpace *as = cpu_get_address_space(CPU(s->armv7m.cpu), 0);
+    address_space_read(as, dma_maddr(s, c), MEMTXATTRS_UNSPECIFIED, buf, msz);
+    *value = buf[0] | (buf[1] << 8) | (buf[2] << 16) | ((uint32_t)buf[3] << 24);
+    dma_item_done(s, c);
+    return true;
+}
+
+/* request selection per RM0377 table "DMA1 requests": csel value per channel */
+static int dma_find(STM32L0State *s, int ch_a, int ch_b, int csel)
+{
+    for (int c = 0; c < 7; c++) {
+        if ((c == ch_a || c == ch_b) && ((s->dma_cselr >> (4 * c)) & 15) == csel &&
+            (s->dma_ccr[c] & 1)) {
+            return c;
+        }
+    }
+    return -1;
+}
+
+static void usart_tx_byte(STM32L0State *s, uint8_t b);
+static void spi_xfer(STM32L0State *s, uint8_t tx);
+static bool spi_is_slave(STM32L0State *s);
+
+/* run memory->peripheral channels for USART1 TX / SPI1 TX until they drain */
+static void dma_kick_tx(STM32L0State *s)
+{
+    uint32_t v;
+    int c;
+    if (s->us_cr3 & 0x80) {                         /* USART1 DMAT: ch2/ch4, csel 3 */
+        while ((c = dma_find(s, 1, 3, 3)) >= 0 && dma_get(s, c, &v)) {
+            usart_tx_byte(s, v);
+        }
+    }
+    if ((s->spi_cr2 & 2) && (s->spi_cr1 & 0x44) == 0x44) {  /* master+SPE, TXDMAEN */
+        while ((c = dma_find(s, 2, 2, 1)) >= 0 && dma_get(s, c, &v)) {
+            spi_xfer(s, v);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- USART1 */
+static void usart_update_irq(STM32L0State *s)
+{
+    uint32_t ie = 0;
+    if (s->us_cr1 & (1 << 5)) { ie |= 1 << 5; }    /* RXNEIE */
+    if (s->us_cr1 & (1 << 6)) { ie |= 1 << 6; }    /* TCIE */
+    if (s->us_cr1 & (1 << 7)) { ie |= 1 << 7; }    /* TXEIE */
+    if (s->us_cr1 & (1 << 4)) { ie |= 1 << 4; }    /* IDLEIE */
+    qemu_set_irq(nvic(s, IRQ_USART1), (s->us_isr & ie) != 0);
+}
+
+static void usart_tx_byte(STM32L0State *s, uint8_t b)
+{
+    sdebug("usart1 tx %02x", b);
+    if (s->usart_tx_hook) {
+        s->usart_tx_hook(s->usart_tx_opaque, b);
+    }
+    s->us_isr |= (1 << 7) | (1 << 6);               /* TXE, TC */
+    usart_update_irq(s);
+}
+
+static void usart_rx_deliver(void *opaque)
+{
+    STM32L0State *s = opaque;
+    if (!(s->us_cr1 & 1) || !(s->us_cr1 & 4)) {      /* UE, RE */
+        return;
+    }
+    while (s->us_rx_head != s->us_rx_tail) {
+        uint8_t b = s->us_rxq[s->us_rx_tail];
+        int c = (s->us_cr3 & 0x40) ? dma_find(s, 2, 4, 3) : -1;   /* DMAR: ch3/ch5 */
+        if (c >= 0) {
+            if (!dma_put(s, c, b)) {
+                break;
+            }
+        } else {
+            if (s->us_isr & (1 << 5)) {
+                break;                               /* previous byte not read yet */
+            }
+            s->us_rdr = b;
+            s->us_isr |= 1 << 5;                     /* RXNE */
+        }
+        s->us_rx_tail = (s->us_rx_tail + 1) % (int)sizeof(s->us_rxq);
+        sdebug("usart1 rx %02x", b);
+    }
+    if (s->us_rx_head == s->us_rx_tail) {
+        s->us_isr |= 1 << 4;                         /* IDLE after the burst */
+    }
+    usart_update_irq(s);
+}
+
+void stm32l0_usart_rx(STM32L0State *s, uint8_t b)
+{
+    int nh = (s->us_rx_head + 1) % (int)sizeof(s->us_rxq);
+    if (nh != s->us_rx_tail) {
+        s->us_rxq[s->us_rx_head] = b;
+        s->us_rx_head = nh;
+    }
+    timer_mod(s->us_rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 20000);
+}
+
+void stm32l0_set_usart_tx_hook(STM32L0State *s, void (*fn)(void *, uint8_t), void *opaque)
+{
+    s->usart_tx_hook = fn;
+    s->usart_tx_opaque = opaque;
+}
+
+static uint64_t usart_read(STM32L0State *s, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return s->us_cr1;
+    case 0x04: return s->us_cr2;
+    case 0x08: return s->us_cr3;
+    case 0x0C: return s->us_brr;
+    case 0x1C: return s->us_isr | (1 << 21) | (1 << 22);    /* TEACK, REACK */
+    case 0x24: {
+        uint32_t v = s->us_rdr;
+        s->us_isr &= ~(1 << 5);
+        usart_update_irq(s);
+        timer_mod(s->us_rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 20000);
+        return v;
+    }
+    default: return 0;
+    }
+}
+
+static void usart_write(STM32L0State *s, hwaddr o, uint32_t v)
+{
+    switch (o) {
+    case 0x00: s->us_cr1 = v; break;
+    case 0x04: s->us_cr2 = v; break;
+    case 0x08: s->us_cr3 = v; dma_kick_tx(s); break;
+    case 0x0C: s->us_brr = v; break;
+    case 0x20: s->us_isr &= ~(v & 0x1F5F); break;          /* ICR */
+    case 0x28: usart_tx_byte(s, v); break;                  /* TDR */
+    }
+    usart_update_irq(s);
+    timer_mod(s->us_rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 20000);
+}
+
+/* ---------------------------------------------------------------- SPI1 */
+static void spi_update_irq(STM32L0State *s)
+{
+    bool irq = ((s->spi_cr2 & 0x40) && s->spi_rxne) ||
+               ((s->spi_cr2 & 0x80) && !s->spi_txfull);
+    qemu_set_irq(nvic(s, IRQ_SPI1), irq);
+}
+
+static void spi_xfer(STM32L0State *s, uint8_t tx)
+{
+    uint8_t rx = 0xFF;                                      /* device not identified */
+    sdebug("spi1 tx %02x", tx);
+    int c = (s->spi_cr2 & 1) ? dma_find(s, 1, 1, 1) : -1;   /* RXDMAEN: ch2 csel 1 */
+    if (c < 0 || !dma_put(s, c, rx)) {
+        s->spi_rxbuf = rx;
+        s->spi_rxne = true;
+    }
+    spi_update_irq(s);
+}
+
+/* ---- slave mode (CR1.MSTR = 0): the external master clocks bytes */
+static bool spi_is_slave(STM32L0State *s)
+{
+    return (s->spi_cr1 & 0x40) && !(s->spi_cr1 & 0x04);
+}
+
+bool stm32l0_spi_slave_tx_pending(STM32L0State *s)
+{
+    int c;
+    if (!spi_is_slave(s)) {
+        return false;
+    }
+    if (s->spi_txfull) {
+        return true;
+    }
+    c = (s->spi_cr2 & 2) ? dma_find(s, 2, 2, 1) : -1;          /* TX DMA ch3 */
+    return c >= 0 && s->dma_cndtr[c] > 0;
+}
+
+uint8_t stm32l0_spi_slave_xfer(STM32L0State *s, uint8_t in)
+{
+    uint32_t out = 0xFF;
+    int c;
+
+    if (!spi_is_slave(s)) {
+        return 0xFF;
+    }
+    if ((s->spi_cr2 & 2) && (c = dma_find(s, 2, 2, 1)) >= 0 && dma_get(s, c, &out)) {
+        /* byte from TX DMA */
+    } else if (s->spi_txfull) {
+        out = s->spi_txbuf;
+        s->spi_txfull = false;
+    }
+    c = (s->spi_cr2 & 1) ? dma_find(s, 1, 1, 1) : -1;
+    if (c < 0 || !dma_put(s, c, in)) {
+        s->spi_rxbuf = in;
+        s->spi_rxne = true;
+    }
+    sdebug("spi1 slave in %02x out %02x", in, (uint8_t)out);
+    spi_update_irq(s);
+    return out;
+}
+
+static uint64_t spi_read(STM32L0State *s, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return s->spi_cr1;
+    case 0x04: return s->spi_cr2;
+    case 0x08: return (s->spi_txfull ? 0 : 0x2) | (s->spi_rxne ? 1 : 0);  /* TXE|RXNE */
+    case 0x0C: s->spi_rxne = false; spi_update_irq(s); return s->spi_rxbuf;
+    default: return 0;
+    }
+}
+
+static void spi_write(STM32L0State *s, hwaddr o, uint32_t v)
+{
+    switch (o) {
+    case 0x00: s->spi_cr1 = v; sdebug("SPI1 CR1 = %04x", (uint32_t)v); dma_kick_tx(s); break;
+    case 0x04: s->spi_cr2 = v; sdebug("SPI1 CR2 = %04x", (uint32_t)v); dma_kick_tx(s); break;
+    case 0x0C:
+        if (spi_is_slave(s)) {
+            s->spi_txbuf = v & 0xFF;     /* shifted out on the master's next clock */
+            s->spi_txfull = true;
+        } else {
+            spi_xfer(s, v);
+        }
+        break;
+    }
+    spi_update_irq(s);
+}
+
+/* ---------------------------------------------------------------- ADC */
+static void adc_update_irq(STM32L0State *s)
+{
+    qemu_set_irq(nvic(s, IRQ_ADC), (s->adc_isr & s->adc_ier & 0x9F) != 0);
+}
+
+static void adc_convert_sequence(STM32L0State *s)
+{
+    bool down = s->adc_cfgr1 & (1 << 2);                    /* SCANDIR */
+    for (int i = 0; i < 19; i++) {
+        int ch = down ? 18 - i : i;
+        if (!(s->adc_chselr & (1u << ch))) {
+            continue;
+        }
+        s->adc_dr = s->adc_val[ch] >> (2 * ((s->adc_cfgr1 >> 3) & 3));   /* RES */
+        s->adc_isr |= (1 << 1) | (1 << 2);                  /* EOSMP, EOC */
+        if (s->adc_cfgr1 & 1) {                             /* DMAEN: ch1/ch2 csel 0 */
+            int c = dma_find(s, 0, 1, 0);
+            if (c >= 0) {
+                dma_put(s, c, s->adc_dr);
+                s->adc_isr &= ~(1 << 2);
+            }
+        }
+    }
+    s->adc_isr |= 1 << 3;                                   /* EOS */
+    if (!(s->adc_cfgr1 & (1 << 13)) && !((s->adc_cfgr1 >> 10) & 3)) {
+        s->adc_cr &= ~(1 << 2);                             /* single sw conversion done */
+    }
+    adc_update_irq(s);
+}
+
+/* hardware trigger from a timer (src = timer number) */
+static void adc_trigger(STM32L0State *s, int src)
+{
+    if (!(s->adc_cr & 1) || !(s->adc_cr & 4) || !((s->adc_cfgr1 >> 10) & 3)) {
+        return;
+    }
+    /* EXTSEL: 0 TIM6_TRGO, 2 TIM21_CC2, 3 TIM2_TRGO, 4 TIM2_CC4, 5 TIM22_TRGO */
+    int sel = (s->adc_cfgr1 >> 6) & 7;
+    if ((sel == 5 && src == 22) || (sel == 3 && src == 2) || (sel == 0 && src == 6) ||
+        (sel == 2 && src == 21)) {
+        adc_convert_sequence(s);
+    }
+}
+
+static uint64_t adc_read(STM32L0State *s, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return s->adc_isr;
+    case 0x04: return s->adc_ier;
+    case 0x08: return s->adc_cr;
+    case 0x0C: return s->adc_cfgr1;
+    case 0x10: return s->adc_cfgr2;
+    case 0x14: return s->adc_smpr;
+    case 0x28: return s->adc_chselr;
+    case 0x40: s->adc_isr &= ~(1 << 2); adc_update_irq(s); return s->adc_dr;
+    case 0x308: return s->adc_ccr;
+    default: return 0;
+    }
+}
+
+static void adc_write(STM32L0State *s, hwaddr o, uint32_t v)
+{
+    switch (o) {
+    case 0x00: s->adc_isr &= ~v; break;
+    case 0x04: s->adc_ier = v; break;
+    case 0x08:
+        if (v & (1u << 31)) {                               /* ADCAL: done at once */
+            v &= ~(1u << 31);
+            s->adc_dr = 0x40;
+        }
+        if (v & 1) {
+            s->adc_isr |= 1;                                /* ADRDY */
+        }
+        if (v & 2) {                                        /* ADDIS */
+            v &= ~3u;
+        }
+        s->adc_cr = v;
+        if ((v & 4) && !((s->adc_cfgr1 >> 10) & 3)) {      /* software start */
+            adc_convert_sequence(s);
+        }
+        break;
+    case 0x0C: s->adc_cfgr1 = v; break;
+    case 0x10: s->adc_cfgr2 = v; break;
+    case 0x14: s->adc_smpr = v; break;
+    case 0x28: s->adc_chselr = v; break;
+    case 0x308: s->adc_ccr = v; break;
+    }
+    adc_update_irq(s);
+}
+
+void stm32l0_set_adc(STM32L0State *s, int ch, uint16_t v)
+{
+    if (ch >= 0 && ch < 19) {
+        s->adc_val[ch] = v & 0xFFF;
+    }
+}
+
+/* ---------------------------------------------------------------- timers */
+static uint64_t tim_tick_ns(STM32L0State *s, L0Tim *t)
+{
+    return MAX(1, 1000000000ULL * (t->psc + 1) / MAX(timclk_hz(s, t->apb), 1));
+}
+
+static uint32_t tim_cnt(STM32L0State *s, L0Tim *t)
+{
+    if (!(t->cr1 & 1) || (t->smcr & 7)) {
+        return t->base_cnt;
+    }
+    int64_t n = (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - t->base_ns) / (int64_t)tim_tick_ns(s, t);
+    return (t->base_cnt + n) % (t->arr + 1);
+}
+
+static void tim_schedule(STM32L0State *s, L0Tim *t)
+{
+    if (!(t->cr1 & 1) || (t->smcr & 7) || t->arr == 0) {
+        timer_del(t->timer);
+        return;
+    }
+    t->base_cnt = tim_cnt(s, t);
+    t->base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    timer_mod(t->timer, t->base_ns + (int64_t)(t->arr + 1 - t->base_cnt) * tim_tick_ns(s, t));
+}
+
+static void tim_update_irq(STM32L0State *s, L0Tim *t)
+{
+    qemu_set_irq(nvic(s, t->irq), (t->sr & t->dier & 0x1F) != 0);
+}
+
+static void tim_expire(void *opaque)
+{
+    L0Tim *t = opaque;
+    STM32L0State *s = t->soc;
+    int num = t == &s->tim[0] ? 2 : t == &s->tim[1] ? 6 : t == &s->tim[2] ? 21 : 22;
+
+    t->base_cnt = 0;
+    t->base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    t->sr |= 1;
+    for (int i = 0; i < 4; i++) {
+        if (t->ccr[i] <= t->arr) {
+            t->sr |= 2u << i;          /* compare match once per period */
+        }
+    }
+    tim_update_irq(s, t);
+    if (((t->cr2 >> 4) & 7) == 2) {   /* MMS = update -> TRGO */
+        adc_trigger(s, num);
+    }
+    if (t->cr1 & 8) {                 /* OPM */
+        t->cr1 &= ~1u;
+    }
+    tim_schedule(s, t);
+}
+
+static uint64_t tim_read(STM32L0State *s, L0Tim *t, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return t->cr1;
+    case 0x04: return t->cr2;
+    case 0x08: return t->smcr;
+    case 0x0C: return t->dier;
+    case 0x10: return t->sr;
+    case 0x18: return t->ccmr1;
+    case 0x1C: return t->ccmr2;
+    case 0x20: return t->ccer;
+    case 0x24: return tim_cnt(s, t);
+    case 0x28: return t->psc;
+    case 0x2C: return t->arr;
+    case 0x34: case 0x38: case 0x3C: case 0x40: return t->ccr[(o - 0x34) / 4];
+    default: return 0;
+    }
+}
+
+static void tim_write(STM32L0State *s, L0Tim *t, hwaddr o, uint32_t v)
+{
+    t->base_cnt = tim_cnt(s, t);
+    t->base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    switch (o) {
+    case 0x00:
+        if ((v & 1) && !(t->cr1 & 1)) {
+            sdebug("%s start psc=%u arr=%u", t->name, t->psc, t->arr);
+        }
+        t->cr1 = v & 0x3FF;
+        break;
+    case 0x04: t->cr2 = v; break;
+    case 0x08: t->smcr = v; break;
+    case 0x0C: t->dier = v; break;
+    case 0x10: t->sr &= v; break;
+    case 0x14: if (v & 1) { t->base_cnt = 0; } break;
+    case 0x18: t->ccmr1 = v; break;
+    case 0x1C: t->ccmr2 = v; break;
+    case 0x20: t->ccer = v; break;
+    case 0x24: t->base_cnt = v & 0xFFFF; break;
+    case 0x28: t->psc = v & 0xFFFF; break;
+    case 0x2C: t->arr = v & 0xFFFF; break;
+    case 0x34: case 0x38: case 0x3C: case 0x40: t->ccr[(o - 0x34) / 4] = v & 0xFFFF; break;
+    }
+    tim_update_irq(s, t);
+    tim_schedule(s, t);
+}
+
+/* ---------------------------------------------------------------- RCC/PWR/FLASH/SYSCFG */
+static uint32_t rcc_read(STM32L0State *s, hwaddr o)
+{
+    uint32_t v = s->rcc[o / 4];
+    switch (o) {
+    case 0x00:                                              /* CR: ready mirrors on */
+        v &= ~((1 << 2) | (1 << 9) | (1 << 17) | (1 << 25));
+        v |= ((v & 1) << 2) | (((v >> 8) & 1) << 9) | (((v >> 16) & 1) << 17) |
+             (((v >> 24) & 1) << 25);
+        return v;
+    case 0x08: return (v & ~2u) | ((v & 1) << 1);           /* CRRCR HSI48RDY */
+    case 0x0C: return (v & ~0xCu) | ((v & 3) << 2);         /* CFGR SWS = SW */
+    case 0x50:                                              /* CSR LSI/LSE ready */
+        v &= ~((1 << 1) | (1 << 9));
+        return v | ((v & 1) << 1) | (((v >> 8) & 1) << 9);
+    default: return v;
+    }
+}
+
+static uint64_t flash_if_read(STM32L0State *s, hwaddr o)
+{
+    switch (o) {
+    case 0x00: return s->fl_acr;
+    case 0x04: return s->fl_pecr;
+    case 0x18: return s->fl_sr | (1 << 2) | (1 << 3);       /* ENDHV, READY */
+    case 0x1C: return s->fl_optr;
+    default: return 0;
+    }
+}
+
+static void flash_if_write(STM32L0State *s, hwaddr o, uint32_t v)
+{
+    switch (o) {
+    case 0x00: s->fl_acr = v; break;
+    case 0x04: s->fl_pecr = (s->fl_pecr & 7) | (v & ~7u) | (v & 7); break;
+    case 0x0C: if (v == 0x02030405) { s->fl_pecr &= ~1u; } break;    /* PEKEYR stage 2 */
+    case 0x10: if (v == 0x13141516) { s->fl_pecr &= ~2u; } break;    /* PRGKEYR stage 2 */
+    case 0x18: s->fl_sr &= ~(v & 0x3F02); break;
+    }
+}
+
+/* ---------------------------------------------------------------- MMIO dispatch */
+static int find_block(hwaddr a, hwaddr *off)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(pmap); i++) {
+        if (a >= pmap[i].base && a < pmap[i].base + 0x400) {
+            *off = a - pmap[i].base;
+            return pmap[i].id;
+        }
+    }
+    return P_NONE;
+}
+
+static L0Tim *tim_of(STM32L0State *s, int id)
+{
+    switch (id) {
+    case P_TIM2: return &s->tim[0];
+    case P_TIM6: return &s->tim[1];
+    case P_TIM21: return &s->tim[2];
+    case P_TIM22: return &s->tim[3];
+    default: return NULL;
+    }
+}
+
+static uint64_t periph_read(void *opaque, hwaddr addr, unsigned size)
+{
+    STM32L0State *s = opaque;
+    hwaddr o;
+    int id = find_block(0x40000000 + addr, &o);
+    L0Tim *t = tim_of(s, id);
+
+    if (t) {
+        return tim_read(s, t, o);
+    }
+    switch (id) {
+    case P_RCC: return o < sizeof(s->rcc) ? rcc_read(s, o) : 0;
+    case P_PWR: return o == 0 ? s->pwr_cr : o == 4 ? s->pwr_csr : 0;
+    case P_FLASH: return flash_if_read(s, o);
+    case P_SYSCFG:
+        if (o == 0x20) {
+            return s->syscfg[o / 4] | (1u << 30) | (1u << 26);  /* VREFINT ready */
+        }
+        return o < sizeof(s->syscfg) ? s->syscfg[o / 4] : 0;
+    case P_EXTI:
+        switch (o) {
+        case 0x00: return s->exti_imr;
+        case 0x04: return s->exti_emr;
+        case 0x08: return s->exti_rtsr;
+        case 0x0C: return s->exti_ftsr;
+        case 0x14: return s->exti_pr;
+        default: return 0;
+        }
+    case P_IWDG: return 0;
+    case P_ADC: return adc_read(s, o);
+    case P_SPI1: return spi_read(s, o);
+    case P_USART1: return usart_read(s, o);
+    case P_DMA1:
+        if (o == 0x00) { return s->dma_isr; }
+        if (o == 0xA8) { return s->dma_cselr; }
+        if (o >= 0x08 && o < 0x08 + 7 * 20) {
+            int c = (o - 0x08) / 20, r = (o - 0x08) % 20;
+            return r == 0 ? s->dma_ccr[c] : r == 4 ? s->dma_cndtr[c] :
+                   r == 8 ? s->dma_cpar[c] : r == 12 ? s->dma_cmar[c] : 0;
+        }
+        return 0;
+    case P_GPIOA: case P_GPIOB: case P_GPIOC: case P_GPIOD: case P_GPIOH:
+        return gpio_read(s, id - P_GPIOA, o);
+    default:
+        qemu_log_mask(LOG_UNIMP, "stm32l0: read %08" HWADDR_PRIx "\n", 0x40000000 + addr);
+        return 0;
+    }
+}
+
+static void periph_write(void *opaque, hwaddr addr, uint64_t v, unsigned size)
+{
+    STM32L0State *s = opaque;
+    hwaddr o;
+    int id = find_block(0x40000000 + addr, &o);
+    L0Tim *t = tim_of(s, id);
+
+    if (t) {
+        tim_write(s, t, o, v);
+        return;
+    }
+    switch (id) {
+    case P_RCC:
+        if (o < sizeof(s->rcc)) {
+            s->rcc[o / 4] = v;
+        }
+        break;
+    case P_PWR:
+        if (o == 0) {
+            s->pwr_cr = v;
+        }
+        break;
+    case P_FLASH: flash_if_write(s, o, v); break;
+    case P_SYSCFG:
+        if (o < sizeof(s->syscfg)) {
+            s->syscfg[o / 4] = v;
+        }
+        sdebug("SYSCFG+%02x = %08x", (unsigned)o, (uint32_t)v);
+        break;
+    case P_EXTI:
+        if (o != 0x14) {
+            sdebug("EXTI+%02x = %08x", (unsigned)o, (uint32_t)v);
+        }
+        switch (o) {
+        case 0x00: s->exti_imr = v; break;
+        case 0x04: s->exti_emr = v; break;
+        case 0x08: s->exti_rtsr = v; break;
+        case 0x0C: s->exti_ftsr = v; break;
+        case 0x10: s->exti_pr |= v & s->exti_imr; break;   /* SWIER */
+        case 0x14: s->exti_pr &= ~v; break;
+        }
+        exti_update_irq(s);
+        break;
+    case P_IWDG: break;
+    case P_ADC: adc_write(s, o, v); break;
+    case P_SPI1: spi_write(s, o, v); break;
+    case P_USART1: usart_write(s, o, v); break;
+    case P_DMA1:
+        if (o == 0x04) {                                    /* IFCR */
+            s->dma_isr &= ~v;
+        } else if (o == 0xA8) {
+            s->dma_cselr = v;
+        } else if (o >= 0x08 && o < 0x08 + 7 * 20) {
+            int c = (o - 0x08) / 20, r = (o - 0x08) % 20;
+            if (r == 0) {
+                if ((v & 1) && !(s->dma_ccr[c] & 1)) {
+                    s->dma_cnt0[c] = s->dma_cndtr[c];
+                    s->dma_pos[c] = 0;
+                    sdebug("dma ch%d on cpar=%08x cmar=%08x n=%u ccr=%x sel=%u", c + 1,
+                           s->dma_cpar[c], s->dma_cmar[c], s->dma_cndtr[c], (uint32_t)v,
+                           (s->dma_cselr >> (4 * c)) & 15);
+                }
+                s->dma_ccr[c] = v;
+                dma_kick_tx(s);
+                timer_mod(s->us_rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 20000);
+            } else if (r == 4) {
+                s->dma_cndtr[c] = v & 0xFFFF;
+            } else if (r == 8) {
+                s->dma_cpar[c] = v;
+            } else if (r == 12) {
+                s->dma_cmar[c] = v;
+            }
+        }
+        dma_update_irq(s);
+        break;
+    case P_GPIOA: case P_GPIOB: case P_GPIOC: case P_GPIOD: case P_GPIOH:
+        gpio_write(s, id - P_GPIOA, o, v);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "stm32l0: write %08" HWADDR_PRIx " = %08" PRIx64 "\n",
+                      0x40000000 + addr, v);
+    }
+}
+
+static const MemoryRegionOps periph_ops = {
+    .read = periph_read,
+    .write = periph_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* ---------------------------------------------------------------- device */
+static void stm32l0_reset(DeviceState *dev)
+{
+    STM32L0State *s = STM32L0(dev);
+
+    memset(s->rcc, 0, sizeof(s->rcc));
+    s->rcc[0x00 / 4] = 0x00000300;          /* MSION + MSIRDY */
+    s->rcc[0x04 / 4] = 5u << 13;            /* MSI range 5 (2.097 MHz) */
+    s->pwr_cr = 0x1000;
+    s->pwr_csr = 0;
+    s->fl_pecr = 7;                         /* PELOCK, PRGLOCK, OPTLOCK */
+    s->fl_sr = 0;
+    memset(s->syscfg, 0, sizeof(s->syscfg));
+    s->exti_imr = 0x3F840000;
+    s->exti_emr = s->exti_rtsr = s->exti_ftsr = s->exti_pr = 0;
+    for (int p = 0; p < NPORT; p++) {
+        s->moder[p] = p == 0 ? 0xEBFFFCFF : p == 1 ? 0xFFFFFFFF : 0xFFFFFFFF;
+        s->pupdr[p] = p == 0 ? 0x24000000 : 0;
+        s->otyper[p] = s->ospeedr[p] = s->odr[p] = 0;
+        s->afr[p][0] = s->afr[p][1] = 0;
+        s->last_idr[p] = gpio_idr(s, p);
+    }
+    for (int i = 0; i < 4; i++) {
+        L0Tim *t = &s->tim[i];
+        t->cr1 = t->cr2 = t->smcr = t->dier = t->sr = t->ccmr1 = t->ccmr2 = t->ccer = 0;
+        t->psc = 0;
+        t->arr = 0xFFFF;
+        memset(t->ccr, 0, sizeof(t->ccr));
+        t->base_cnt = 0;
+        timer_del(t->timer);
+    }
+    s->adc_isr = s->adc_ier = s->adc_cr = s->adc_cfgr1 = s->adc_cfgr2 = 0;
+    s->adc_smpr = s->adc_chselr = s->adc_dr = s->adc_ccr = 0;
+    s->dma_isr = s->dma_cselr = 0;
+    memset(s->dma_ccr, 0, sizeof(s->dma_ccr));
+    s->spi_cr1 = s->spi_cr2 = 0;
+    s->spi_rxne = s->spi_txfull = false;
+    s->us_cr1 = s->us_cr2 = s->us_cr3 = s->us_brr = 0;
+    s->us_isr = (1 << 7) | (1 << 6);
+    s->us_rx_head = s->us_rx_tail = 0;
+}
+
+/* The M-profile CPU reset fetches SP/PC before the firmware copy is visible to it, so
+ * reload them from the vector table at 0x08000000 after every system reset. */
+static void stm32l0_cpu_reset(void *opaque)
+{
+    STM32L0State *s = opaque;
+    ARMCPU *cpu = s->armv7m.cpu;
+    uint32_t *v = memory_region_get_ram_ptr(&s->flash);
+
+    cpu_reset(CPU(cpu));
+    cpu->env.regs[13] = le32_to_cpu(v[0]) & ~3u;
+    cpu->env.regs[15] = le32_to_cpu(v[1]) & ~1u;
+    cpu->env.thumb = 1;
+    sdebug("reset: SP=%08x PC=%08x", cpu->env.regs[13], cpu->env.regs[15]);
+}
+
+static void stm32l0_realize(DeviceState *dev, Error **errp)
+{
+    STM32L0State *s = STM32L0(dev);
+    const char *adc = getenv("RZA1H_SUB_ADC");
+
+    memory_region_init(&s->container, OBJECT(s), "stm32l0-container", UINT64_MAX);
+
+    clock_set_hz(s->sysclk, 32000000);
+    clock_set_hz(s->refclk, 1000000);
+    qdev_connect_clock_in(DEVICE(&s->armv7m), "cpuclk", s->sysclk);
+    qdev_connect_clock_in(DEVICE(&s->armv7m), "refclk", s->refclk);
+    object_property_set_link(OBJECT(&s->armv7m), "memory", OBJECT(&s->container),
+                             &error_abort);
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->armv7m), errp)) {
+        return;
+    }
+    /* the cluster counts its CPUs at realize, so it must follow armv7m */
+    qdev_prop_set_uint32(DEVICE(&s->cluster), "cluster-id", 1);
+    qdev_realize(DEVICE(&s->cluster), NULL, &error_fatal);
+
+    memory_region_init_ram(&s->flash, OBJECT(s), "stm32l0.flash", FLASH_SIZE, &error_fatal);
+    memory_region_add_subregion(&s->container, FLASH_BASE, &s->flash);
+    memory_region_init_alias(&s->flash_alias, OBJECT(s), "stm32l0.flash-alias", &s->flash,
+                             0, FLASH_SIZE);
+    memory_region_add_subregion(&s->container, 0, &s->flash_alias);
+    memory_region_init_ram(&s->sram, OBJECT(s), "stm32l0.sram", SRAM_SIZE, &error_fatal);
+    memory_region_add_subregion(&s->container, SRAM_BASE, &s->sram);
+    memory_region_init_ram(&s->eeprom, OBJECT(s), "stm32l0.eeprom", EEPROM_SIZE, &error_fatal);
+    memory_region_add_subregion(&s->container, EEPROM_BASE, &s->eeprom);
+    memory_region_init_io(&s->periph, OBJECT(s), &periph_ops, s, "stm32l0.periph", 0x10002000);
+    memory_region_add_subregion(&s->container, 0x40000000, &s->periph);
+    memory_region_init_ram(&s->sysmem_rom, OBJECT(s), "stm32l0.sysinfo", 0x100, &error_fatal);
+    memory_region_add_subregion(&s->container, 0x1FF80000, &s->sysmem_rom);
+
+    if (s->fw_path) {
+        gsize len = 0;
+        gchar *data = NULL;
+        if (!g_file_get_contents(s->fw_path, &data, &len, NULL)) {
+            error_setg(errp, "stm32l0: cannot read firmware %s", s->fw_path);
+            return;
+        }
+        memcpy(memory_region_get_ram_ptr(&s->flash), data, MIN(len, FLASH_SIZE));
+        g_free(data);
+    }
+
+    for (int i = 0; i < 19; i++) {
+        /* IC-705: channels 0, 1, 14, 15 are the key ladders (sub 0x8004714); open = 0xFFF.
+         * ch4 is reported to the ARM on request (sub 0x8003BD4, reply bit 4); any level there
+         * keeps the ARM out of deep standby (external-DC / charge mode) -> default 0. */
+        s->adc_val[i] = (i == 0 || i == 1 || i == 14 || i == 15) ? 0xFFF : i == 4 ? 0 : 0x800;
+    }
+    for (int i = 0; adc && *adc && i < 19; i++) {
+        s->adc_val[i] = strtoul(adc, NULL, 0) & 0xFFF;
+        adc = strchr(adc, ',');
+        if (!adc) {
+            break;
+        }
+        adc++;
+    }
+
+    static const char *tn[4] = { "TIM2", "TIM6", "TIM21", "TIM22" };
+    static const int ti[4] = { IRQ_TIM2, IRQ_TIM6, IRQ_TIM21, IRQ_TIM22 };
+    for (int i = 0; i < 4; i++) {
+        s->tim[i].soc = s;
+        s->tim[i].name = tn[i];
+        s->tim[i].irq = ti[i];
+        s->tim[i].apb = i >= 2 ? 2 : 1;
+        s->tim[i].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, tim_expire, &s->tim[i]);
+    }
+    s->us_rx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, usart_rx_deliver, s);
+    qemu_register_reset(stm32l0_cpu_reset, s);
+}
+
+/* QOM "adc" (write-only): "ch=val[,ch=val...]", 12-bit full-scale values, settable live
+ * from QMP (qom-set /machine/subcpu adc "0=0x080") to press front-panel keys. */
+static void stm32l0_set_adc_prop(Object *obj, const char *str, Error **errp)
+{
+    STM32L0State *s = STM32L0(obj);
+    const char *p = str;
+
+    while (p && *p) {
+        char *e;
+        long ch = strtol(p, &e, 0);
+        if (*e != '=') {
+            error_setg(errp, "adc: expected ch=val");
+            return;
+        }
+        unsigned long v = strtoul(e + 1, &e, 0);
+        if (ch >= 0 && ch < 19) {
+            s->adc_val[ch] = v & 0xFFF;
+            sdebug("adc ch%ld = %#lx", ch, v & 0xFFF);
+        }
+        p = *e == ',' ? e + 1 : NULL;
+    }
+}
+
+static char *stm32l0_get_adc_prop(Object *obj, Error **errp)
+{
+    STM32L0State *s = STM32L0(obj);
+    GString *g = g_string_new("");
+    for (int i = 0; i < 19; i++) {
+        g_string_append_printf(g, "%s%d=%#x", i ? "," : "", i, s->adc_val[i]);
+    }
+    return g_string_free(g, false);
+}
+
+static void stm32l0_init(Object *obj)
+{
+    STM32L0State *s = STM32L0(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    object_initialize_child(obj, "cluster", &s->cluster, TYPE_CPU_CLUSTER);
+    object_initialize_child(OBJECT(&s->cluster), "armv6m", &s->armv7m, TYPE_ARMV7M);
+    qdev_prop_set_string(DEVICE(&s->armv7m), "cpu-type", ARM_CPU_TYPE_NAME("cortex-m0"));
+    qdev_prop_set_uint32(DEVICE(&s->armv7m), "num-irq", 32);
+    s->sysclk = qdev_init_clock_in(dev, "sysclk", NULL, NULL, 0);
+    s->refclk = qdev_init_clock_in(dev, "refclk", NULL, NULL, 0);
+
+    object_property_add_str(obj, "adc", stm32l0_get_adc_prop, stm32l0_set_adc_prop);
+    qdev_init_gpio_in_named(dev, gpio_in_a, "pa", 16);
+    qdev_init_gpio_in_named(dev, gpio_in_b, "pb", 16);
+    qdev_init_gpio_in_named(dev, gpio_in_c, "pc", 16);
+    qdev_init_gpio_in_named(dev, gpio_in_d, "pd", 16);
+    qdev_init_gpio_in_named(dev, gpio_in_h, "ph", 16);
+    qdev_init_gpio_out_named(dev, s->gpio_out[0], "pa-out", 16);
+    qdev_init_gpio_out_named(dev, s->gpio_out[1], "pb-out", 16);
+    qdev_init_gpio_out_named(dev, s->gpio_out[2], "pc-out", 16);
+    qdev_init_gpio_out_named(dev, s->gpio_out[3], "pd-out", 16);
+    qdev_init_gpio_out_named(dev, s->gpio_out[4], "ph-out", 16);
+}
+
+static const Property stm32l0_props[] = {
+    DEFINE_PROP_STRING("firmware", STM32L0State, fw_path),
+};
+
+static void stm32l0_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = stm32l0_realize;
+    device_class_set_legacy_reset(dc, stm32l0_reset);
+    device_class_set_props(dc, stm32l0_props);
+}
+
+static const TypeInfo stm32l0_info = {
+    .name = TYPE_STM32L0,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(STM32L0State),
+    .instance_init = stm32l0_init,
+    .class_init = stm32l0_class_init,
+};
+
+static void stm32l0_register(void)
+{
+    type_register_static(&stm32l0_info);
+}
+
+type_init(stm32l0_register)
