+/* IC-705 port: generic pin levels. Spec "port_bit=level,..." e.g. "3_9=1,7_8=0".
+ * RZA1H_PINS applies at reset; the QOM string property "pins" applies live. */
+/* IC-705 port: board-level hook so a pin driven here also reaches another chip (the
+ * POWER key goes to both P3_9 and the sub-CPU's PC13). */
+void (*rza1h_gpio_pin_hook)(int port, int bit, int level);
+/* output-latch hook: board wiring from an RZ output pin to another chip */
+void (*rza1h_gpio_out_hook)(int port, int bit, int level);
+void (*rza1h_gpio_pm_hook)(int port, int bit, int input);
+
+static void rza1h_gpio_apply_pins(RZA1HGpioState *s, const char *spec)
+{
+    while (spec && *spec) {
+        unsigned port, bit, lvl;
+        if (sscanf(spec, "%u_%u=%u", &port, &bit, &lvl) == 3 && port < NUM_PORTS && bit < 16) {
+            if (lvl) {
+                s->pin_level[port] |= 1u << bit;
+            } else {
+                s->pin_level[port] &= ~(1u << bit);
+            }
+            if (rza1h_gpio_pin_hook) {
+                rza1h_gpio_pin_hook(port, bit, lvl);
+            }
+        }
+        spec = strchr(spec, ',');
+        if (spec) {
+            spec++;
+        }
+    }
+}
+
+/* Latch an external-IRQ request flag (IRQRR bit n), e.g. the IC-705 RTC tick on IRQ0. */
