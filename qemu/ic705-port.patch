diff --git a/qemu-machine/src/adc.c b/qemu-machine/src/adc.c
index bf2411b..2b99d9e 100644
--- a/qemu-machine/src/adc.c
+++ b/qemu-machine/src/adc.c
@@ -48,6 +48,7 @@
 #include "qom/object.h"
 
 #include "rz_a1h.h"
+#include "rza1h_debug.h"
 
 OBJECT_DECLARE_SIMPLE_TYPE(RZA1HAdcState, RZA1H_ADC)
 
@@ -55,10 +56,12 @@ struct RZA1HAdcState {
     SysBusDevice parent_obj;
     MemoryRegion iomem;
     uint8_t regs[RZA1H_ADC_SIZE];
+    int32_t val[8];   /* IC-705 port: live 10-bit readings, -1 = not set (see "vals") */
 };
 
 #define ADC_DRA 0x00
 #define ADC_DRH 0x0e
+#define ADC_ADCSR 0x60
 
 /* Mid-scale 10-bit reading (0x200 of 0-0x3ff), left-justified per the real register's own
  * bits-15:6 layout -- see the file comment for why >>6 in the real driver confirms this. */
@@ -70,6 +73,20 @@ static uint64_t rza1h_adc_read(void *opaque, hwaddr offset, unsigned size)
     uint64_t val = 0;
 
     if (offset <= ADC_DRH && (offset % 2) == 0) {
+        int ch = offset / 2;
+        if (s->val[ch] >= 0) {
+            return (s->val[ch] & 0x3ff) << 6;
+        }
+        /* RZA1H_ADC_VALS="v0,v1,...,v7" (10-bit) overrides per-channel readings */
+        const char *e = getenv("RZA1H_ADC_VALS");
+        if (e) {
+            int i = 0;
+            const char *p = e;
+            while (*p && i < ch) { if (*p++ == ',') i++; }
+            if (i == ch && *p) {
+                return (strtoul(p, NULL, 0) & 0x3ff) << 6;
+            }
+        }
         return ADC_QUIESCENT_READING;
     }
 
@@ -82,6 +99,23 @@ static void rza1h_adc_write(void *opaque, hwaddr offset, uint64_t value,
 {
     RZA1HAdcState *s = RZA1H_ADC(opaque);
 
+    /* IC-705 port: single-conversion completion. The IC-705 starts a conversion with
+     * ADCSR.ADST (bit 13) and polls ADF (bit 15) set + ADST clear; complete instantly.
+     * Writing ADF=0 clears it (RZ/A1 ADCSR semantics). */
+    if (rza1h_board_ic705() && offset == ADC_ADCSR && size == 2) {
+        uint16_t old, v = value;
+        memcpy(&old, &s->regs[offset], 2);
+        if (!(v & 0x8000)) {
+            old &= ~0x8000;
+        }
+        if (v & 0x2000) {
+            v = (v & ~0x2000) | 0x8000;
+        } else {
+            v = (v & ~0x8000) | (old & 0x8000);
+        }
+        memcpy(&s->regs[offset], &v, 2);
+        return;
+    }
     memcpy(&s->regs[offset], &value, size);
 }
 
@@ -100,11 +134,45 @@ static void rza1h_adc_reset(DeviceState *dev)
     memset(s->regs, 0, sizeof(s->regs));
 }
 
+/* IC-705 port: QOM string property "vals" = "ch=value,..." (10-bit) sets channels live,
+ * e.g. qom-set /machine/adc vals "4=0x3ff,5=0x1c0"; value -1 returns a channel to
+ * RZA1H_ADC_VALS / mid-scale. Used for the ARM-side key ladders (ch4/ch5/ch6). */
+static char *rza1h_adc_get_vals(Object *obj, Error **errp)
+{
+    RZA1HAdcState *s = RZA1H_ADC(obj);
+    GString *g = g_string_new(NULL);
+    for (int i = 0; i < 8; i++) {
+        g_string_append_printf(g, "%s%d=%d", i ? "," : "", i, s->val[i]);
+    }
+    return g_string_free(g, false);
+}
+
+static void rza1h_adc_set_vals(Object *obj, const char *v, Error **errp)
+{
+    RZA1HAdcState *s = RZA1H_ADC(obj);
+    const char *p = v;
+    while (p && *p) {
+        char *end;
+        long ch = strtol(p, &end, 0);
+        if (*end != '=' || ch < 0 || ch > 7) {
+            break;
+        }
+        s->val[ch] = strtol(end + 1, &end, 0);
+        rza1h_debug("adc", "ch%ld = %d", ch, s->val[ch]);
+        p = *end == ',' ? end + 1 : NULL;
+    }
+}
+
 static void rza1h_adc_init(Object *obj)
 {
     SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
     RZA1HAdcState *s = RZA1H_ADC(obj);
 
+    for (int i = 0; i < 8; i++) {
+        s->val[i] = -1;
+    }
+    object_property_add_str(obj, "vals", rza1h_adc_get_vals, rza1h_adc_set_vals);
+
     memory_region_init_io(&s->iomem, obj, &rza1h_adc_ops, s,
                           TYPE_RZA1H_ADC, RZA1H_ADC_SIZE);
     sysbus_init_mmio(sbd, &s->iomem);
diff --git a/qemu-machine/src/bq2571x.c b/qemu-machine/src/bq2571x.c
new file mode 100644
index 0000000..2e7d5bc
--- /dev/null
+++ b/qemu-machine/src/bq2571x.c
@@ -0,0 +1,87 @@
+/*
+ * Battery charger, TI BQ2571x class, written for the IC-705 port.
+ *
+ * The IC-705 programs a charger on RIIC1 at 0x6B through 16-bit registers 0x00..0x3A
+ * (low byte at the even address) and reads some back to compare, among them the ADC/status
+ * words 0x28 and 0x2C [FW 0x20019B28 write, 0x2001A174 read, table 0x2001A504]. This model
+ * is a register file with an auto-incrementing pointer: writes are stored, reads return the
+ * stored value. Manufacturer/device ID (0x2E/0x2F) read as a BQ25713 (0x40/0x88). Charging
+ * itself is not modelled.
+ */
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "qom/object.h"
+#include "rza1h_debug.h"
+
+#define TYPE_BQ2571X "bq2571x"
+OBJECT_DECLARE_SIMPLE_TYPE(Bq2571xState, BQ2571X)
+
+struct Bq2571xState {
+    I2CSlave parent_obj;
+    uint8_t regs[256];
+    uint8_t ptr;
+    bool addr_byte;
+};
+
+static int bq_event(I2CSlave *i2c, enum i2c_event event)
+{
+    Bq2571xState *s = BQ2571X(i2c);
+    if (event == I2C_START_SEND) {
+        s->addr_byte = true;
+    }
+    return 0;
+}
+
+static int bq_send(I2CSlave *i2c, uint8_t data)
+{
+    Bq2571xState *s = BQ2571X(i2c);
+    if (s->addr_byte) {
+        s->ptr = data;
+        s->addr_byte = false;
+    } else {
+        rza1h_debug("bq", "w %02x = %02x", s->ptr, data);
+        if (s->ptr != 0x2E && s->ptr != 0x2F) {
+            s->regs[s->ptr] = data;
+        }
+        s->ptr++;
+    }
+    return 0;
+}
+
+static uint8_t bq_recv(I2CSlave *i2c)
+{
+    Bq2571xState *s = BQ2571X(i2c);
+    return s->regs[s->ptr++];
+}
+
+static void bq_reset(DeviceState *dev)
+{
+    Bq2571xState *s = BQ2571X(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x2E] = 0x40;       /* ManufacturerID: TI */
+    s->regs[0x2F] = 0x88;       /* DeviceID: BQ25713 */
+    s->ptr = 0;
+}
+
+static void bq_class_init(ObjectClass *oc, const void *data)
+{
+    I2CSlaveClass *isc = I2C_SLAVE_CLASS(oc);
+    isc->event = bq_event;
+    isc->recv = bq_recv;
+    isc->send = bq_send;
+    device_class_set_legacy_reset(DEVICE_CLASS(oc), bq_reset);
+}
+
+static const TypeInfo bq_info = {
+    .name          = TYPE_BQ2571X,
+    .parent        = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(Bq2571xState),
+    .class_init    = bq_class_init,
+};
+
+static void bq_register(void)
+{
+    type_register_static(&bq_info);
+}
+
+type_init(bq_register)
diff --git a/qemu-machine/src/dmac.c b/qemu-machine/src/dmac.c
