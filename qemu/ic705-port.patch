diff --git a/qemu-machine/src/adc.c b/qemu-machine/src/adc.c
index bf2411b..2ade9c9 100644
--- a/qemu-machine/src/adc.c
+++ b/qemu-machine/src/adc.c
@@ -48,6 +48,7 @@
 #include "qom/object.h"
 
 #include "rz_a1h.h"
+#include "rza1h_debug.h"
 
 OBJECT_DECLARE_SIMPLE_TYPE(RZA1HAdcState, RZA1H_ADC)
 
@@ -59,6 +60,7 @@ struct RZA1HAdcState {
 
 #define ADC_DRA 0x00
 #define ADC_DRH 0x0e
+#define ADC_ADCSR 0x60
 
 /* Mid-scale 10-bit reading (0x200 of 0-0x3ff), left-justified per the real register's own
  * bits-15:6 layout -- see the file comment for why >>6 in the real driver confirms this. */
@@ -70,6 +72,16 @@ static uint64_t rza1h_adc_read(void *opaque, hwaddr offset, unsigned size)
     uint64_t val = 0;
 
     if (offset <= ADC_DRH && (offset % 2) == 0) {
+        /* RZA1H_ADC_VALS="v0,v1,...,v7" (10-bit) overrides per-channel readings */
+        const char *e = getenv("RZA1H_ADC_VALS");
+        if (e) {
+            int ch = offset / 2, i = 0;
+            const char *p = e;
+            while (*p && i < ch) { if (*p++ == ',') i++; }
+            if (i == ch && *p) {
+                return (strtoul(p, NULL, 0) & 0x3ff) << 6;
+            }
+        }
         return ADC_QUIESCENT_READING;
     }
 
@@ -82,6 +94,23 @@ static void rza1h_adc_write(void *opaque, hwaddr offset, uint64_t value,
 {
     RZA1HAdcState *s = RZA1H_ADC(opaque);
 
+    /* IC-705 port: single-conversion completion. The IC-705 starts a conversion with
+     * ADCSR.ADST (bit 13) and polls ADF (bit 15) set + ADST clear; complete instantly.
+     * Writing ADF=0 clears it (RZ/A1 ADCSR semantics). */
+    if (rza1h_board_ic705() && offset == ADC_ADCSR && size == 2) {
+        uint16_t old, v = value;
+        memcpy(&old, &s->regs[offset], 2);
+        if (!(v & 0x8000)) {
+            old &= ~0x8000;
+        }
+        if (v & 0x2000) {
+            v = (v & ~0x2000) | 0x8000;
+        } else {
+            v = (v & ~0x8000) | (old & 0x8000);
+        }
+        memcpy(&s->regs[offset], &v, 2);
+        return;
+    }
     memcpy(&s->regs[offset], &value, size);
 }
 
diff --git a/qemu-machine/src/dmac_hi.c b/qemu-machine/src/dmac_hi.c
new file mode 100644
index 0000000..9dfd6d9
--- /dev/null
+++ b/qemu-machine/src/dmac_hi.c
@@ -0,0 +1,203 @@
+/*
+ * RZ/A1H DMAC channels 8..15 -- generic model, written for the IC-705 port.
+ *
+ * dmac.c models channels 0..7 around the IC-7300's flows (SSIF streaming, SDHI, ch0
+ * completion). The IC-705 firmware also uses channel 10 (0xE8200484/0xE82004A8) for a
+ * buffer transfer paced by MTU2 channel 2 and waits for its completion (0x2011EBBC /
+ * 0x2011F254). This device covers the second register window (0xE8200400, 8 channels x
+ * 0x40) plus the common DCTRL/DSTAT block at +0x300 of that window:
+ *
+ *   SETEN with N0TB > 0: move N0TB bytes from N0SA to N0DA in CHCFG.DDS units
+ *   (SAD/DAD = fixed address), then CHSTAT.END, EN cleared, DMAINT(8+n) raised unless
+ *   CHCFG.DEM masks it. CLREND/CLREN/SWRST behave as on hardware. Completion is
+ *   delayed by DMAC_HI_UNIT_NS per unit (approximates a timer-paced request).
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+
+#define NCH 8
+#define STRIDE 0x40
+#define N0SA 0x00
+#define N0DA 0x04
+#define N0TB 0x08
+#define CHSTAT 0x24
+#define CHCTRL 0x28
+#define CHCFG 0x2c
+#define ST_EN (1u << 0)
+#define ST_END (1u << 6)
+#define CTL_SETEN (1u << 0)
+#define CTL_CLREN (1u << 1)
+#define CTL_SWRST (1u << 3)
+#define CTL_CLREND (1u << 5)
+#define CFG_SAD (1u << 20)
+#define CFG_DAD (1u << 21)
+#define CFG_DEM (1u << 24)
+#define DMAC_HI_UNIT_NS 1000
+
+OBJECT_DECLARE_SIMPLE_TYPE(RZA1HDmacHiState, RZA1H_DMAC_HI)
+
+struct RZA1HDmacHiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint8_t regs[0x400];
+    uint32_t chstat[NCH];
+    QEMUTimer *timer[NCH];
+    qemu_irq irq[NCH];
+};
+
+static uint32_t rd32(RZA1HDmacHiState *s, int off)
+{
+    uint32_t v;
+    memcpy(&v, &s->regs[off], 4);
+    return v;
+}
+
+static void update_irq(RZA1HDmacHiState *s, int ch)
+{
+    bool dem = rd32(s, ch * STRIDE + CHCFG) & CFG_DEM;
+    qemu_set_irq(s->irq[ch], (s->chstat[ch] & ST_END) && !dem);
+}
+
+static void complete(RZA1HDmacHiState *s, int ch)
+{
+    s->chstat[ch] = (s->chstat[ch] & ~ST_EN) | ST_END;
+    rza1h_debug("dmac", "dmac_hi ch%d complete", 8 + ch);
+    update_irq(s, ch);
+}
+
+static void timer_cb(void *opaque, int ch)
+{
+    complete(opaque, ch);
+}
+static void t0(void *o) { timer_cb(o, 0); }
+static void t1(void *o) { timer_cb(o, 1); }
+static void t2(void *o) { timer_cb(o, 2); }
+static void t3(void *o) { timer_cb(o, 3); }
+static void t4(void *o) { timer_cb(o, 4); }
+static void t5(void *o) { timer_cb(o, 5); }
+static void t6(void *o) { timer_cb(o, 6); }
+static void t7(void *o) { timer_cb(o, 7); }
+
+static void start(RZA1HDmacHiState *s, int ch)
+{
+    int b = ch * STRIDE;
+    uint32_t sa = rd32(s, b + N0SA), da = rd32(s, b + N0DA), n = rd32(s, b + N0TB);
+    uint32_t cfg = rd32(s, b + CHCFG);
+    static const int sz[8] = { 1, 2, 4, 8, 16, 32, 64, 128 };
+    int unit = sz[(cfg >> 16) & 7];   /* DDS */
+    uint8_t buf[128];
+
+    s->chstat[ch] |= ST_EN;
+    rza1h_debug("dmac", "dmac_hi ch%d SETEN sa=%#x da=%#x n=%u cfg=%#x", 8 + ch, sa, da, n, cfg);
+    for (uint32_t off = 0; off < n; off += unit) {
+        int u = MIN((uint32_t)unit, n - off);
+        address_space_read(&address_space_memory, sa + ((cfg & CFG_SAD) ? 0 : off),
+                           MEMTXATTRS_UNSPECIFIED, buf, u);
+        address_space_write(&address_space_memory, da + ((cfg & CFG_DAD) ? 0 : off),
+                            MEMTXATTRS_UNSPECIFIED, buf, u);
+    }
+    timer_mod(s->timer[ch], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (int64_t)(n / unit + 1) * DMAC_HI_UNIT_NS);
+}
+
+static uint64_t dh_read(void *opaque, hwaddr off, unsigned size)
+{
+    RZA1HDmacHiState *s = opaque;
+    int ch = off / STRIDE;
+    uint32_t v;
+
+    if (ch < NCH && off % STRIDE == CHSTAT) {
+        return s->chstat[ch];
+    }
+    memcpy(&v, &s->regs[off], 4);
+    return size == 4 ? v : size == 2 ? (v & 0xffff) : (v & 0xff);
+}
+
+static void dh_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    RZA1HDmacHiState *s = opaque;
+    int ch = off / STRIDE;
+
+    if (ch < NCH && off % STRIDE == CHCTRL) {
+        if (v & CTL_SWRST) {
+            s->chstat[ch] = 0;
+            timer_del(s->timer[ch]);
+        }
+        if (v & CTL_CLREN) {
+            s->chstat[ch] &= ~ST_EN;
+            timer_del(s->timer[ch]);
+        }
+        if (v & CTL_CLREND) {
+            s->chstat[ch] &= ~ST_END;
+        }
+        if (v & CTL_SETEN) {
+            start(s, ch);
+        }
+        update_irq(s, ch);
+        return;
+    }
+    memcpy(&s->regs[off], &v, size);
+    if (ch < NCH && off % STRIDE == CHCFG) {
+        update_irq(s, ch);
+    }
+}
+
+static const MemoryRegionOps dh_ops = {
+    .read = dh_read,
+    .write = dh_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void dh_reset(DeviceState *dev)
+{
+    RZA1HDmacHiState *s = RZA1H_DMAC_HI(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    for (int ch = 0; ch < NCH; ch++) {
+        s->chstat[ch] = 0;
+        timer_del(s->timer[ch]);
+        qemu_irq_lower(s->irq[ch]);
+    }
+}
+
+static void dh_init(Object *obj)
+{
+    RZA1HDmacHiState *s = RZA1H_DMAC_HI(obj);
+    static void (*const cb[NCH])(void *) = { t0, t1, t2, t3, t4, t5, t6, t7 };
+
+    memory_region_init_io(&s->iomem, obj, &dh_ops, s, "rza1h-dmac-hi", 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    for (int ch = 0; ch < NCH; ch++) {
+        s->timer[ch] = timer_new_ns(QEMU_CLOCK_VIRTUAL, cb[ch], s);
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[ch]);
+    }
+}
+
+static void dh_class_init(ObjectClass *oc, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(oc), dh_reset);
+}
+
+static const TypeInfo dh_info = {
+    .name = TYPE_RZA1H_DMAC_HI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RZA1HDmacHiState),
+    .instance_init = dh_init,
+    .class_init = dh_class_init,
+};
+
+static void dh_register(void)
+{
+    type_register_static(&dh_info);
+}
+
+type_init(dh_register)
diff --git a/qemu-machine/src/gpio.c b/qemu-machine/src/gpio.c
index 908927a..750981f 100644
--- a/qemu-machine/src/gpio.c
+++ b/qemu-machine/src/gpio.c
@@ -423,6 +423,8 @@ static const MemoryRegionOps rza1h_gpio_ops = {
     .endianness = DEVICE_LITTLE_ENDIAN,
 };
 
+static void rza1h_gpio_apply_pins(RZA1HGpioState *s, const char *spec);
+
 static void rza1h_gpio_reset(DeviceState *dev)
 {
     RZA1HGpioState *s = RZA1H_GPIO(dev);
@@ -477,12 +479,53 @@ static void rza1h_gpio_reset(DeviceState *dev)
      * P8_9/P1_7 above. See rza1h_gpio_set_civ_bus_busy() for how to simulate it going busy. */
     s->pin_level[7] |= 0x800;
 
+    if (rza1h_board_ic705()) {
+        /* IC-705 idle input levels (pull-ups): P3_9 = POWER key, released high [FW] */
+        s->pin_level[3] |= 1u << 9;
+    }
+    rza1h_gpio_apply_pins(s, getenv("RZA1H_PINS"));
+
     s->icr0 = s->icr1 = 0;
     s->irqrr = 0;
     qemu_irq_lower(s->irq7);
     qemu_irq_lower(s->irq3);
 }
 
+/* IC-705 port: generic pin levels. Spec "port_bit=level,..." e.g. "3_9=1,7_8=0".
+ * RZA1H_PINS applies at reset; the QOM string property "pins" applies live. */
+static void rza1h_gpio_apply_pins(RZA1HGpioState *s, const char *spec)
+{
+    while (spec && *spec) {
+        unsigned port, bit, lvl;
+        if (sscanf(spec, "%u_%u=%u", &port, &bit, &lvl) == 3 && port < NUM_PORTS && bit < 16) {
+            if (lvl) {
+                s->pin_level[port] |= 1u << bit;
+            } else {
+                s->pin_level[port] &= ~(1u << bit);
+            }
+        }
+        spec = strchr(spec, ',');
+        if (spec) {
+            spec++;
+        }
+    }
+}
+
+static char *rza1h_gpio_get_pins(Object *obj, Error **errp)
+{
+    RZA1HGpioState *s = RZA1H_GPIO(obj);
+    GString *g = g_string_new("");
+    for (int p = 0; p < NUM_PORTS; p++) {
+        g_string_append_printf(g, "%sP%d=%04x", p ? " " : "", p, s->pin_level[p]);
+    }
+    return g_string_free(g, false);
+}
+
+static void rza1h_gpio_set_pins(Object *obj, const char *v, Error **errp)
+{
+    rza1h_gpio_apply_pins(RZA1H_GPIO(obj), v);
+}
+
 /* Live PWRK press/release for testing (2026-09-20) -- not a real hardware input this project
  * has any other way to drive, and this project's own PPR write handler correctly ignores guest
  * writes (PPR is real-hardware read-only), so a host-side QOM property is the only way to
@@ -579,6 +622,7 @@ static void rza1h_gpio_init(Object *obj)
                              rza1h_gpio_set_pwrk_pressed);
     object_property_add_bool(obj, "civ-bus-busy", rza1h_gpio_get_civ_bus_busy,
                              rza1h_gpio_set_civ_bus_busy);
+    object_property_add_str(obj, "pins", rza1h_gpio_get_pins, rza1h_gpio_set_pins);
 }
 
 static void rza1h_gpio_class_init(ObjectClass *oc, const void *data)
diff --git a/qemu-machine/src/mtu2g.c b/qemu-machine/src/mtu2g.c
new file mode 100644
index 0000000..1664993
--- /dev/null
+++ b/qemu-machine/src/mtu2g.c
@@ -0,0 +1,319 @@
+/*
+ * RZ/A1H MTU2 -- general (register-accurate) model, written for the IC-705 port.
+ *
+ * mtu2.c models exactly the compare-match events the IC-7300 firmware uses, armed by the
+ * register writes that firmware happens to make. The IC-705 firmware drives the same
+ * timer differently (e.g. its TGI4A handler starts the ADC), so this device instead
+ * models the timer itself:
+ *
+ *  - channels 0..4, each a 16-bit TCNT counting P0phi / prescaler while TSTR.CSTn is set;
+ *  - compare match on TGRA..TGRD (ch0 also E/F are ignored), setting TSR.TGFx and, when
+ *    TIER.TGIEx is set, raising that event's GIC line (level, until the flag is cleared);
+ *  - counter clear on TGRA/B/C/D compare match (TCR.CCLR), overflow (TCFV / TCIEV);
+ *  - TSR flags cleared by writing 0.
+ *
+ * Counting is evaluated lazily from the virtual clock; one QEMUTimer per channel fires at
+ * the next compare/overflow. Offsets follow the RZ/A1H hardware manual's MTU2 map
+ * (TGRC_3 0x224, TGRD_3 0x226, TGRC_4 0x228, TGRD_4 0x22A). Note mtu2.c labels 0x224 as
+ * TGRC_4; that disagrees with this table and is unresolved [INF].
+ *
+ * Clock: 32 MHz (mtu2.c's value, derived for the IC-7300); the IC-705's exact P0phi is
+ * not yet confirmed.
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+
+#define MTU2G_FREQ_HZ 32000000ULL
+#define MTU2G_NCH 5
+
+OBJECT_DECLARE_SIMPLE_TYPE(RZA1HMtu2gState, RZA1H_MTU2G)
+
+/* Per-channel register offsets (-1 = not present). */
+typedef struct {
+    int tcr, tier, tsr, tcnt, tgr[4];
+    int cst_bit;            /* bit in TSTR */
+    int irq_base;           /* GIC ID of TGIxA; B,C,D follow (+1,+2,+3), V at irq_v */
+    int irq_v;
+    int ntgr;
+} Mtu2gCh;
+
+static const Mtu2gCh mtu2g_ch[MTU2G_NCH] = {
+    /* ch0 */ { 0x300, 0x304, 0x305, 0x306, { 0x308, 0x30a, 0x30c, 0x30e }, 0, 139, 143, 4 },
+    /* ch1 */ { 0x380, 0x384, 0x385, 0x386, { 0x388, 0x38a, -1, -1 },       1, 146, 148, 2 },
+    /* ch2 */ { 0x000, 0x004, 0x005, 0x006, { 0x008, 0x00a, -1, -1 },       2, 150, 152, 2 },
+    /* ch3 */ { 0x200, 0x208, 0x22c, 0x210, { 0x218, 0x21a, 0x224, 0x226 }, 6, 154, 158, 4 },
+    /* ch4 */ { 0x201, 0x209, 0x22d, 0x212, { 0x21c, 0x21e, 0x228, 0x22a }, 7, 159, 163, 4 },
+};
+#define MTU2G_TSTR 0x280
+
+struct RZA1HMtu2gState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint8_t regs[RZA1H_MTU2_SIZE];
+    /* lazy counter state */
+    int64_t base_ns[MTU2G_NCH];
+    uint32_t base_cnt[MTU2G_NCH];
+    QEMUTimer *timer[MTU2G_NCH];
+    uint32_t tgt_cnt[MTU2G_NCH];  /* count value at the scheduled event (0x10000 = overflow) */
+    int64_t tgt_ns[MTU2G_NCH];
+    qemu_irq irq[MTU2G_NCH][5];   /* A,B,C,D,V */
+};
+
+static uint16_t r16(RZA1HMtu2gState *s, int off)
+{
+    return s->regs[off] | (s->regs[off + 1] << 8);   /* little-endian bus */
+}
+
+static void w16(RZA1HMtu2gState *s, int off, uint16_t v)
+{
+    s->regs[off] = v; s->regs[off + 1] = v >> 8;
+}
+
+static bool running(RZA1HMtu2gState *s, int c)
+{
+    return s->regs[MTU2G_TSTR] & (1 << mtu2g_ch[c].cst_bit);
+}
+
+static uint64_t tick_ns(RZA1HMtu2gState *s, int c)
+{
+    static const int div[8] = { 1, 4, 16, 64, 256, 1024, 1, 1 };
+    int tpsc = s->regs[mtu2g_ch[c].tcr] & 7;
+    return (1000000000ULL * div[tpsc]) / MTU2G_FREQ_HZ ?: 1;
+}
+
+static uint16_t cur_tcnt(RZA1HMtu2gState *s, int c)
+{
+    if (!running(s, c)) {
+        return s->base_cnt[c];
+    }
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    return (s->base_cnt[c] + (now - s->base_ns[c]) / tick_ns(s, c)) & 0xffff;
+}
+
+static void freeze(RZA1HMtu2gState *s, int c)
+{
+    s->base_cnt[c] = cur_tcnt(s, c);
+    s->base_ns[c] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void update_irqs(RZA1HMtu2gState *s, int c)
+{
+    const Mtu2gCh *ch = &mtu2g_ch[c];
+    uint8_t act = s->regs[ch->tsr] & s->regs[ch->tier];
+    for (int i = 0; i < 4; i++) {
+        qemu_set_irq(s->irq[c][i], (act >> i) & 1);
+    }
+    qemu_set_irq(s->irq[c][4], (act >> 4) & 1);
+}
+
+/* Schedule the next compare-match/overflow event of channel c. */
+static void schedule(RZA1HMtu2gState *s, int c)
+{
+    const Mtu2gCh *ch = &mtu2g_ch[c];
+    if (!running(s, c)) {
+        timer_del(s->timer[c]);
+        return;
+    }
+    uint16_t now = cur_tcnt(s, c);
+    uint32_t best = 0x10000 - now;                      /* overflow */
+    for (int i = 0; i < ch->ntgr; i++) {
+        uint16_t tg = r16(s, ch->tgr[i]);
+        uint32_t d = (uint16_t)(tg - now);
+        if (d == 0) {
+            d = 0x10000;
+        }
+        if (d < best) {
+            best = d;
+        }
+    }
+    s->tgt_cnt[c] = now + best;
+    s->tgt_ns[c] = s->base_ns[c] + ((int64_t)((uint16_t)(now - s->base_cnt[c])) + best) * tick_ns(s, c);
+    timer_mod(s->timer[c], s->tgt_ns[c]);
+}
+
+static void fire(void *opaque, int c)
+{
+    RZA1HMtu2gState *s = opaque;
+    const Mtu2gCh *ch = &mtu2g_ch[c];
+    int64_t now_ns = s->tgt_ns[c];
+    uint16_t now = s->tgt_cnt[c] & 0xffff;
+    int cclr = s->regs[ch->tcr] >> 5;
+    bool clear = false;
+
+    for (int i = 0; i < ch->ntgr; i++) {
+        if (r16(s, ch->tgr[i]) == now) {
+            s->regs[ch->tsr] |= 1 << i;
+            if ((i == 0 && cclr == 1) || (i == 1 && cclr == 2) ||
+                (i == 2 && cclr == 5) || (i == 3 && cclr == 6)) {
+                clear = true;
+            }
+            rza1h_debug("mtu2", "ch%d TGI%c match tcnt=%#x (GIC %d)%s", c, 'A' + i, now,
+                        ch->irq_base + i, (s->regs[ch->tier] >> i) & 1 ? "" : " [masked]");
+        }
+    }
+    if (now == 0) {
+        s->regs[ch->tsr] |= 1 << 4;
+    }
+    if (clear) {
+        s->base_cnt[c] = 0;
+        s->base_ns[c] = now_ns;
+    } else {
+        s->base_cnt[c] = now;
+        s->base_ns[c] = now_ns;
+    }
+    update_irqs(s, c);
+    schedule(s, c);
+}
+
+static void fire0(void *o) { fire(o, 0); }
+static void fire1(void *o) { fire(o, 1); }
+static void fire2(void *o) { fire(o, 2); }
+static void fire3(void *o) { fire(o, 3); }
+static void fire4(void *o) { fire(o, 4); }
+
+static int chan_of_tcnt(int off)
+{
+    for (int c = 0; c < MTU2G_NCH; c++) {
+        if (off == mtu2g_ch[c].tcnt || off == mtu2g_ch[c].tcnt + 1) {   /* +0 low, +1 high */
+            return c;
+        }
+    }
+    return -1;
+}
+
+static uint64_t mtu2g_read(void *opaque, hwaddr off, unsigned size)
+{
+    RZA1HMtu2gState *s = opaque;
+    int c = chan_of_tcnt(off);
+    if (c >= 0) {
+        uint16_t v = cur_tcnt(s, c);
+        if (size == 2) {
+            return v;
+        }
+        return off == mtu2g_ch[c].tcnt ? v & 0xff : v >> 8;
+    }
+    if (size == 2) {
+        return r16(s, off);
+    }
+    if (size == 4) {
+        return r16(s, off) | ((uint32_t)r16(s, off + 2) << 16);
+    }
+    return s->regs[off];
+}
+
+static void mtu2g_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    RZA1HMtu2gState *s = opaque;
+    int c;
+
+    /* snapshot all counters before any configuration change */
+    for (c = 0; c < MTU2G_NCH; c++) {
+        freeze(s, c);
+    }
+    if (off == MTU2G_TSTR && size == 1) {
+        s->regs[off] = v;
+    } else if ((c = chan_of_tcnt(off)) >= 0) {
+        s->base_cnt[c] = size == 2 ? v & 0xffff : (off == mtu2g_ch[c].tcnt
+                         ? (s->base_cnt[c] & 0xff00) | (v & 0xff)
+                         : ((v & 0xff) << 8) | (s->base_cnt[c] & 0xff));
+    } else {
+        bool is_tsr = false;
+        for (c = 0; c < MTU2G_NCH; c++) {
+            if (off == mtu2g_ch[c].tsr && size == 1) {
+                /* flags clear on writing 0; bits written 1 keep their value */
+                s->regs[off] &= (v | 0xc0);
+                is_tsr = true;
+            }
+        }
+        if (!is_tsr) {
+            if (size == 1) {
+                s->regs[off] = v;
+            } else if (size == 2) {
+                w16(s, off, v);
+            } else {
+                w16(s, off, v); w16(s, off + 2, v >> 16);
+            }
+        }
+    }
+    for (c = 0; c < MTU2G_NCH; c++) {
+        update_irqs(s, c);
+        schedule(s, c);
+    }
+}
+
+static const MemoryRegionOps mtu2g_ops = {
+    .read = mtu2g_read,
+    .write = mtu2g_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void mtu2g_reset(DeviceState *dev)
+{
+    RZA1HMtu2gState *s = RZA1H_MTU2G(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    for (int c = 0; c < MTU2G_NCH; c++) {
+        static const int tgr_reset = 0xffff;
+        s->base_cnt[c] = 0;
+        s->base_ns[c] = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        for (int i = 0; i < mtu2g_ch[c].ntgr; i++) {
+            w16(s, mtu2g_ch[c].tgr[i], tgr_reset);
+        }
+        s->regs[mtu2g_ch[c].tsr] = 0xc0;
+        timer_del(s->timer[c]);
+    }
+}
+
+static void mtu2g_init(Object *obj)
+{
+    RZA1HMtu2gState *s = RZA1H_MTU2G(obj);
+    static void (*const cb[MTU2G_NCH])(void *) = { fire0, fire1, fire2, fire3, fire4 };
+
+    memory_region_init_io(&s->iomem, obj, &mtu2g_ops, s, "rza1h-mtu2g", RZA1H_MTU2_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    for (int c = 0; c < MTU2G_NCH; c++) {
+        s->timer[c] = timer_new_ns(QEMU_CLOCK_VIRTUAL, cb[c], s);
+        for (int i = 0; i < 5; i++) {
+            sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[c][i]);
+        }
+    }
+}
+
+/* GIC ID of event i (0..4 = A,B,C,D,V) of channel c, or -1 if the channel lacks it. */
+int rza1h_mtu2g_irq_id(int c, int i)
+{
+    const Mtu2gCh *ch = &mtu2g_ch[c];
+    if (i == 4) {
+        return ch->irq_v;
+    }
+    return i < ch->ntgr ? ch->irq_base + i : -1;
+}
+
+static void mtu2g_class_init(ObjectClass *oc, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(oc), mtu2g_reset);
+}
+
+static const TypeInfo mtu2g_info = {
+    .name = TYPE_RZA1H_MTU2G,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RZA1HMtu2gState),
+    .instance_init = mtu2g_init,
+    .class_init = mtu2g_class_init,
+};
+
+static void mtu2g_register(void)
+{
+    type_register_static(&mtu2g_info);
+}
+
+type_init(mtu2g_register)
diff --git a/qemu-machine/src/rspi_gen.c b/qemu-machine/src/rspi_gen.c
new file mode 100644
index 0000000..3570cc1
--- /dev/null
+++ b/qemu-machine/src/rspi_gen.c
@@ -0,0 +1,173 @@
+/*
+ * RZ/A1H RSPI (channels 0..4) -- generic register model, written for the IC-705 port.
+ *
+ * rspi2.c models RSPI2 around the IC-7300 fake FPGA. The IC-705 talks to SPI devices on
+ * RSPI0/1/3/4 (and polls RSPI0 SPSR during bring-up), so this device models the master
+ * itself: every byte written to SPDR is clocked out at once and the attached device's
+ * reply byte is queued in the RX FIFO. The default device answers 0xFF (an idle MISO
+ * line); RZA1H_RSPI<n>_MISO=0xNN overrides the idle byte per channel.
+ *
+ * Registers (offsets per RZ/A1H manual): SPCR +0 (SPRIE b7, SPE b6, SPTIE b5),
+ * SPSR +3 (SPRF b7, TEND b6, SPTEF b5), SPDR +4 (8/16/32-bit access = 1/2/4 frames),
+ * SPBFCR +0x20 (TXRST b7, RXRST b6), SPBFDR +0x22 (T count b11..8, R count b5..0).
+ * Interrupts: SPEI/SPRI/SPTI = GIC 270/271/272 + 3*ch.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "hw/core/qdev-properties.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+
+#define SPCR 0x00
+#define SPSR 0x03
+#define SPDR 0x04
+#define SPBFCR 0x20
+#define SPBFDR 0x22
+#define SPCR_SPRIE 0x80
+#define SPCR_SPE 0x40
+#define SPCR_SPTIE 0x20
+#define SPSR_SPRF 0x80
+#define SPSR_TEND 0x40
+#define SPSR_SPTEF 0x20
+#define RXQ 64
+
+OBJECT_DECLARE_SIMPLE_TYPE(RZA1HRspiGState, RZA1H_RSPI_GEN)
+
+struct RZA1HRspiGState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t channel;
+    uint8_t regs[0x100];
+    uint8_t rx[RXQ];
+    int rx_n;
+    qemu_irq irq_rx, irq_tx;
+};
+
+static uint8_t dev_reply(RZA1HRspiGState *s, uint8_t tx)
+{
+    char name[24];
+    snprintf(name, sizeof(name), "RZA1H_RSPI%u_MISO", s->channel);
+    const char *e = getenv(name);
+    return e ? strtoul(e, NULL, 0) : 0xFF;
+}
+
+static void update(RZA1HRspiGState *s)
+{
+    uint8_t cr = s->regs[SPCR];
+    qemu_set_irq(s->irq_rx, (cr & SPCR_SPRIE) && s->rx_n > 0);
+    qemu_set_irq(s->irq_tx, (cr & SPCR_SPTIE) && (cr & SPCR_SPE));
+}
+
+static uint64_t rg_read(void *opaque, hwaddr off, unsigned size)
+{
+    RZA1HRspiGState *s = opaque;
+    uint64_t v = 0;
+
+    switch (off) {
+    case SPSR:
+        return (s->rx_n ? SPSR_SPRF : 0) | SPSR_TEND | SPSR_SPTEF | (s->regs[SPSR] & 0x1f);
+    case SPDR: {
+        int n = size;               /* frames of 8 bits, LSB first */
+        for (int i = 0; i < n; i++) {
+            uint8_t b = 0xFF;
+            if (s->rx_n) {
+                b = s->rx[0];
+                memmove(s->rx, s->rx + 1, --s->rx_n);
+            }
+            v |= (uint64_t)b << (8 * (n - 1 - i));
+        }
+        update(s);
+        return v;
+    }
+    case SPBFDR:
+        return MIN(s->rx_n, 32);
+    default:
+        memcpy(&v, &s->regs[off], size);
+        return v;
+    }
+}
+
+static void rg_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    RZA1HRspiGState *s = opaque;
+
+    switch (off) {
+    case SPDR:
+        for (int i = size - 1; i >= 0; i--) {
+            uint8_t tx = v >> (8 * i);
+            uint8_t rb = dev_reply(s, tx);
+            if (s->rx_n < RXQ) {
+                s->rx[s->rx_n++] = rb;
+            }
+            rza1h_debug("rspi", "rspi%u tx %02x rx %02x", s->channel, tx, rb);
+        }
+        break;
+    case SPBFCR:
+        if (v & 0x40) {
+            s->rx_n = 0;
+        }
+        s->regs[off] = v & 0x3f;
+        break;
+    case SPSR:
+        s->regs[off] &= v;      /* error flags clear by writing 0 */
+        break;
+    default:
+        memcpy(&s->regs[off], &v, size);
+        break;
+    }
+    update(s);
+}
+
+static const MemoryRegionOps rg_ops = {
+    .read = rg_read,
+    .write = rg_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void rg_reset(DeviceState *dev)
+{
+    RZA1HRspiGState *s = RZA1H_RSPI_GEN(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->rx_n = 0;
+    update(s);
+}
+
+static void rg_init(Object *obj)
+{
+    RZA1HRspiGState *s = RZA1H_RSPI_GEN(obj);
+    memory_region_init_io(&s->iomem, obj, &rg_ops, s, "rza1h-rspi-gen", 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_rx);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_tx);
+}
+
+static const Property rg_props[] = {
+    DEFINE_PROP_UINT32("channel", RZA1HRspiGState, channel, 0),
+};
+
+static void rg_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    device_class_set_legacy_reset(dc, rg_reset);
+    device_class_set_props(dc, rg_props);
+}
+
+static const TypeInfo rg_info = {
+    .name = TYPE_RZA1H_RSPI_GEN,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RZA1HRspiGState),
+    .instance_init = rg_init,
+    .class_init = rg_class_init,
+};
+
+static void rg_register(void)
+{
+    type_register_static(&rg_info);
+}
+
+type_init(rg_register)
