--- a/qemu-machine/src/dmac.c
+++ b/qemu-machine/src/dmac.c
@@ -177,6 +177,8 @@ struct RZA1HDmacState {
     bool stream_running;        /* stream_timer is running */
     uint8_t stream_set[RZA1H_DMAC_CHANNELS];   /* register set the next completion uses */
     uint32_t chstat[RZA1H_DMAC_CHANNELS];      /* ch1-7 CHSTAT (EN, END, SR) */
+    QEMUTimer *gen_timer[RZA1H_DMAC_CHANNELS]; /* IC-705 generic block transfers */
+    uint32_t gen_defer;                        /* channels whose move happens at completion */
     uint64_t stream_blocks[RZA1H_DMAC_CHANNELS];
     uint64_t stream_overruns[RZA1H_DMAC_CHANNELS]; /* END still set at the next block */
     uint8_t sdhi_armed;         /* SETEN'd channels with SDHI0 on one side */
@@ -205,7 +207,7 @@ struct RZA1HDmacState {
 #define DMAC_N1TB 0x14
 #define DMAC_CHSTAT 0x24
 #define DMAC_CHSTAT_EN  (1u << 0)
-#define DMAC_CHSTAT_END (1u << 6)
+#define DMAC_CHSTAT_END (3u << 5) /* END (bit 5) + TC (bit 6) */
 #define DMAC_CHSTAT_SR  (1u << 7)
 #define DMAC_CHCTRL_CLREN  (1u << 1)
 #define DMAC_CHCTRL_SWRST  (1u << 3)
@@ -448,6 +450,51 @@ static void rza1h_dmac_sdhi_dreq(void *opaque, int n, int level)
     }
 }
 
+static RZA1HDmacState *dmac_gen_owner;
+
+static void rza1h_dmac_gen_move(RZA1HDmacState *s, int ch)
+{
+    hwaddr base = ch * DMAC_CH_STRIDE;
+    uint32_t src = dmac_reg32(s, base + DMAC_N0SA_0);
+    uint32_t dst = dmac_reg32(s, base + DMAC_N0DA_0);
+    uint32_t count = dmac_reg32(s, base + DMAC_N0TB_0);
+    uint32_t cfg = dmac_reg32(s, base + DMAC_CHCFG_0);
+    static const int sz[8] = { 1, 2, 4, 8, 16, 32, 64, 128 };
+    int unit = sz[(cfg >> 16) & 7];
+    uint8_t buf[128];
+
+    for (uint32_t off = 0; off < count; off += unit) {
+        int u = MIN((uint32_t)unit, count - off);
+        address_space_read(&address_space_memory, src + ((cfg & DMAC_CHCFG_SAD) ? 0 : off),
+                           MEMTXATTRS_UNSPECIFIED, buf, u);
+        address_space_write(&address_space_memory, dst + ((cfg & DMAC_CHCFG_DAD) ? 0 : off),
+                            MEMTXATTRS_UNSPECIFIED, buf, u);
+    }
+}
+
+static void rza1h_dmac_gen_done(void *opaque)
+{
+    int ch = (intptr_t)opaque;
+    RZA1HDmacState *s = dmac_gen_owner;
+    hwaddr base = ch * DMAC_CH_STRIDE;
+
+    if (s->gen_defer & (1u << ch)) {
+        /* reads from a serial receiver happen at the end, after the transmit side (often
+         * another channel started just after this one) has clocked its bytes */
+        s->gen_defer &= ~(1u << ch);
+        rza1h_dmac_gen_move(s, ch);
+        if (dmac_reg32(s, base + DMAC_N0SA_0) == RZA1H_RSPI0_SPDR) {
+            rza1h_rspi_dma_rx(0, false);
+        }
+    }
+    s->chstat[ch] = DMAC_CHSTAT_END;
+    rza1h_debug("dmac", "ch%d generic done, cfg %#x%s", ch, dmac_reg32(s, base + DMAC_CHCFG_0),
+                (dmac_reg32(s, base + DMAC_CHCFG_0) & DMAC_CHCFG_DEM) ? " (DEM: no irq)" : "");
+    if (!(dmac_reg32(s, base + DMAC_CHCFG_0) & DMAC_CHCFG_DEM)) {
+        qemu_irq_pulse(s->irq[ch]);
+    }
+}
+
 static void rza1h_dmac_seten(RZA1HDmacState *s, int ch)
 {
     hwaddr base = ch * DMAC_CH_STRIDE;
@@ -476,6 +523,49 @@ static void rza1h_dmac_seten(RZA1HDmacState *s, int ch)
         rza1h_dmac_sdhi_move(s);
         return;
     }
+    if (rza1h_board_ic705() && (src == RZA1H_RSPI0_SPDR || dst == RZA1H_RSPI0_SPDR)) {
+        /* IC-705: RSPI0 = the DV-DSP link (FW 0x20200244 / 0x201FFA44): RX DMA from SPDR
+         * (deferred to completion), TX DMA into SPDR. */
+        uint32_t cfg = dmac_reg32(s, base + DMAC_CHCFG_0);
+        static const int sz[8] = { 1, 2, 4, 8, 16, 32, 64, 128 };
+        int unit = sz[(cfg >> 16) & 7];
+
+        s->chstat[ch] = DMAC_CHSTAT_EN;
+        if (src == RZA1H_RSPI0_SPDR) {
+            s->gen_defer |= 1u << ch;
+            rza1h_rspi_dma_rx(0, true);
+        } else {
+            rza1h_dmac_gen_move(s, ch);
+        }
+        rza1h_debug("dmac", "ch%d rspi0: src=%#x dst=%#x count=%u", ch, src, dst, count);
+        timer_mod(s->gen_timer[ch], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (int64_t)(count / unit + 2) * 1000);
+        return;
+    }
+    if (rza1h_board_ic705() && ((dst >= 0xFCFE3000 && dst < 0xFCFE4000) ||
+                                 (src >= 0xFCFE3000 && src < 0xFCFE4000))) {
+        /* IC-705: generic block transfer to/from the GPIO block (ch2 plays the touch-controller command
+         * waveform into PSR3, FW 0x2008CECC; completion ISR 0x2008CF34 on DMAINT2). All
+         * units are moved at once; END + DMAINT follow 1 us per unit later. */
+        uint32_t cfg = dmac_reg32(s, base + DMAC_CHCFG_0);
+        static const int sz[8] = { 1, 2, 4, 8, 16, 32, 64, 128 };
+        int unit = sz[(cfg >> 16) & 7];
+        uint8_t buf[128];
+
+        for (uint32_t off = 0; off < count; off += unit) {
+            int u = MIN((uint32_t)unit, count - off);
+            address_space_read(&address_space_memory, src + ((cfg & DMAC_CHCFG_SAD) ? 0 : off),
+                               MEMTXATTRS_UNSPECIFIED, buf, u);
+            address_space_write(&address_space_memory, dst + ((cfg & DMAC_CHCFG_DAD) ? 0 : off),
+                                MEMTXATTRS_UNSPECIFIED, buf, u);
+        }
+        s->chstat[ch] = DMAC_CHSTAT_EN;
+        rza1h_debug("dmac", "ch%d generic: src=%#x dst=%#x count=%u cfg=%#x", ch, src, dst,
+                    count, cfg);
+        timer_mod(s->gen_timer[ch], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (int64_t)(count / unit + 1) * 1000);
+        return;
+    }
     if (src != RZA1H_RSPI2_SPDR && dst != RZA1H_RSPI2_SPDR) {
         rza1h_debug("dmac", "ch%d SETEN ignored (src=%#x dst=%#x count=%u): "
                    "not an RSPI2 transfer", ch, src, dst, count);
@@ -566,7 +656,10 @@ static void rza1h_dmac_init(Object *obj)
     sysbus_init_irq(sbd, &s->irq0);
     for (int ch = 1; ch < RZA1H_DMAC_CHANNELS; ch++) {
         sysbus_init_irq(sbd, &s->irq[ch]);   /* sysbus IRQ index ch */
+        s->gen_timer[ch] = timer_new_ns(QEMU_CLOCK_VIRTUAL, rza1h_dmac_gen_done,
+                                        (void *)(intptr_t)ch);
     }
+    dmac_gen_owner = s;
     qdev_init_gpio_in_named(DEVICE(obj), rza1h_dmac_sdhi_dreq, "sdhi-dreq", 1);
 }
 
diff --git a/qemu-machine/src/dmac_hi.c b/qemu-machine/src/dmac_hi.c
new file mode 100644
index 0000000..24e9e67
--- /dev/null
+++ b/qemu-machine/src/dmac_hi.c
@@ -0,0 +1,203 @@
+/*
+ * RZ/A1H DMAC channels 8..15 -- generic model, written for the IC-705 port.
+ *
+ * dmac.c models channels 0..7 around the IC-7300's flows (SSIF streaming, SDHI, ch0
+ * completion). The IC-705 firmware also uses channel 10 (0xE8200484/0xE82004A8) for a
+ * buffer transfer paced by MTU2 channel 2 and waits for its completion (0x2011EBBC /
+ * 0x2011F254). This device covers the second register window (0xE8200400, 8 channels x
+ * 0x40) plus the common DCTRL/DSTAT block at +0x300 of that window:
+ *
+ *   SETEN with N0TB > 0: move N0TB bytes from N0SA to N0DA in CHCFG.DDS units
+ *   (SAD/DAD = fixed address), then CHSTAT.END, EN cleared, DMAINT(8+n) raised unless
+ *   CHCFG.DEM masks it. CLREND/CLREN/SWRST behave as on hardware. Completion is
+ *   delayed by DMAC_HI_UNIT_NS per unit (approximates a timer-paced request).
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+
+#define NCH 8
+#define STRIDE 0x40
+#define N0SA 0x00
+#define N0DA 0x04
+#define N0TB 0x08
+#define CHSTAT 0x24
+#define CHCTRL 0x28
+#define CHCFG 0x2c
+#define ST_EN (1u << 0)
+#define ST_END (3u << 5)      /* END (bit 5) + TC (bit 6): both set when a transfer ends */
+#define CTL_SETEN (1u << 0)
+#define CTL_CLREN (1u << 1)
+#define CTL_SWRST (1u << 3)
+#define CTL_CLREND (1u << 5)
+#define CFG_SAD (1u << 20)
+#define CFG_DAD (1u << 21)
+#define CFG_DEM (1u << 24)
+#define DMAC_HI_UNIT_NS 1000
+
+OBJECT_DECLARE_SIMPLE_TYPE(RZA1HDmacHiState, RZA1H_DMAC_HI)
+
+struct RZA1HDmacHiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint8_t regs[0x400];
+    uint32_t chstat[NCH];
+    QEMUTimer *timer[NCH];
+    qemu_irq irq[NCH];
+};
+
+static uint32_t rd32(RZA1HDmacHiState *s, int off)
+{
+    uint32_t v;
+    memcpy(&v, &s->regs[off], 4);
+    return v;
+}
+
+static void update_irq(RZA1HDmacHiState *s, int ch)
+{
+    bool dem = rd32(s, ch * STRIDE + CHCFG) & CFG_DEM;
+    qemu_set_irq(s->irq[ch], (s->chstat[ch] & ST_END) && !dem);
+}
+
+static void complete(RZA1HDmacHiState *s, int ch)
+{
+    s->chstat[ch] = (s->chstat[ch] & ~ST_EN) | ST_END;
+    rza1h_debug("dmac", "dmac_hi ch%d complete", 8 + ch);
+    update_irq(s, ch);
+}
+
+static void timer_cb(void *opaque, int ch)
+{
+    complete(opaque, ch);
+}
+static void t0(void *o) { timer_cb(o, 0); }
+static void t1(void *o) { timer_cb(o, 1); }
+static void t2(void *o) { timer_cb(o, 2); }
+static void t3(void *o) { timer_cb(o, 3); }
+static void t4(void *o) { timer_cb(o, 4); }
+static void t5(void *o) { timer_cb(o, 5); }
+static void t6(void *o) { timer_cb(o, 6); }
+static void t7(void *o) { timer_cb(o, 7); }
+
+static void start(RZA1HDmacHiState *s, int ch)
+{
+    int b = ch * STRIDE;
+    uint32_t sa = rd32(s, b + N0SA), da = rd32(s, b + N0DA), n = rd32(s, b + N0TB);
+    uint32_t cfg = rd32(s, b + CHCFG);
+    static const int sz[8] = { 1, 2, 4, 8, 16, 32, 64, 128 };
+    int unit = sz[(cfg >> 16) & 7];   /* DDS */
+    uint8_t buf[128];
+
+    s->chstat[ch] |= ST_EN;
+    rza1h_debug("dmac", "dmac_hi ch%d SETEN sa=%#x da=%#x n=%u cfg=%#x", 8 + ch, sa, da, n, cfg);
+    for (uint32_t off = 0; off < n; off += unit) {
+        int u = MIN((uint32_t)unit, n - off);
+        address_space_read(&address_space_memory, sa + ((cfg & CFG_SAD) ? 0 : off),
+                           MEMTXATTRS_UNSPECIFIED, buf, u);
+        address_space_write(&address_space_memory, da + ((cfg & CFG_DAD) ? 0 : off),
+                            MEMTXATTRS_UNSPECIFIED, buf, u);
+    }
+    timer_mod(s->timer[ch], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (int64_t)(n / unit + 1) * DMAC_HI_UNIT_NS);
+}
+
+static uint64_t dh_read(void *opaque, hwaddr off, unsigned size)
+{
+    RZA1HDmacHiState *s = opaque;
+    int ch = off / STRIDE;
+    uint32_t v;
+
+    if (ch < NCH && off % STRIDE == CHSTAT) {
+        return s->chstat[ch];
+    }
+    memcpy(&v, &s->regs[off], 4);
+    return size == 4 ? v : size == 2 ? (v & 0xffff) : (v & 0xff);
+}
+
+static void dh_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    RZA1HDmacHiState *s = opaque;
+    int ch = off / STRIDE;
+
+    if (ch < NCH && off % STRIDE == CHCTRL) {
+        if (v & CTL_SWRST) {
+            s->chstat[ch] = 0;
+            timer_del(s->timer[ch]);
+        }
+        if (v & CTL_CLREN) {
+            s->chstat[ch] &= ~ST_EN;
+            timer_del(s->timer[ch]);
+        }
+        if (v & CTL_CLREND) {
+            s->chstat[ch] &= ~ST_END;
+        }
+        if (v & CTL_SETEN) {
+            start(s, ch);
+        }
+        update_irq(s, ch);
+        return;
+    }
+    memcpy(&s->regs[off], &v, size);
+    if (ch < NCH && off % STRIDE == CHCFG) {
+        update_irq(s, ch);
+    }
+}
+
+static const MemoryRegionOps dh_ops = {
+    .read = dh_read,
+    .write = dh_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void dh_reset(DeviceState *dev)
+{
+    RZA1HDmacHiState *s = RZA1H_DMAC_HI(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    for (int ch = 0; ch < NCH; ch++) {
+        s->chstat[ch] = 0;
+        timer_del(s->timer[ch]);
+        qemu_irq_lower(s->irq[ch]);
+    }
+}
+
+static void dh_init(Object *obj)
+{
+    RZA1HDmacHiState *s = RZA1H_DMAC_HI(obj);
+    static void (*const cb[NCH])(void *) = { t0, t1, t2, t3, t4, t5, t6, t7 };
+
+    memory_region_init_io(&s->iomem, obj, &dh_ops, s, "rza1h-dmac-hi", 0x400);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    for (int ch = 0; ch < NCH; ch++) {
+        s->timer[ch] = timer_new_ns(QEMU_CLOCK_VIRTUAL, cb[ch], s);
+        sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[ch]);
+    }
+}
+
+static void dh_class_init(ObjectClass *oc, const void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(oc), dh_reset);
+}
+
+static const TypeInfo dh_info = {
+    .name = TYPE_RZA1H_DMAC_HI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RZA1HDmacHiState),
+    .instance_init = dh_init,
+    .class_init = dh_class_init,
+};
+
+static void dh_register(void)
+{
+    type_register_static(&dh_info);
+}
+
+type_init(dh_register)
