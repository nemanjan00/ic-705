+/* IC-705 board wiring between the RZ/A1H pins and the sub-CPU */
+static STM32L0State *ic705_sub;
+static DeviceState *ic705_scif3, *ic705_gpio;
+static QEMUTimer *ic705_clk_timer;
+
+/* SCIF3 TX byte: clock-synchronous mode = SPI master clocking the sub-CPU's SPI1 slave
+ * (full duplex); asynchronous mode = UART to the sub-CPU's USART1 (boot loader). */
+static void ic705_scif3_tx(void *opaque, uint8_t b)
+{
+    uint16_t smr, scr;
+    int rxq;
+    rza1h_scif_get_mode(ic705_scif3, &smr, &scr, &rxq);
+    if (smr & 0x80) {
+        uint8_t out = stm32l0_spi_slave_xfer(ic705_sub, b);
+        if (scr & 0x10) {                                  /* RE */
+            rza1h_scif_rx_byte(ic705_scif3, out);
+        }
+    } else {
+        stm32l0_usart_rx(ic705_sub, b);
+    }
+}
+
+/* Receive-only synchronous reception: the SCIF keeps clocking while RE is set and TE
+ * clear; pull the slave's pending bytes. */
+static void ic705_clk_tick(void *opaque)
+{
+    uint16_t smr, scr;
+    int rxq;
+    rza1h_scif_get_mode(ic705_scif3, &smr, &scr, &rxq);
+    if ((smr & 0x80) && (scr & 0x10) && !(scr & 0x20) && rxq < 4 &&
+        stm32l0_spi_slave_tx_pending(ic705_sub)) {
+        rza1h_scif_rx_byte(ic705_scif3, stm32l0_spi_slave_xfer(ic705_sub, 0xFF));
+    }
+    timer_mod(ic705_clk_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 20000);
+}
+
+static ARMCPU *ic705_a9;
+static void rza1h_cpu_reset(void *opaque);
+
+/* Deep standby: the firmware's final power-off (0x20078278) arms cancel sources
+ * (bits 13/10/4/3), clears DSFR, sets STBCR1 STBY|DEEP (0xFCFE0020) and executes WFI.
+ * A cancel event resets the RZ/A1H with the factor bit in DSFR (0xFCFF1808). Which
+ * factor bit the sub-CPU request line drives is selected by RZA1H_DSWAKE_BIT (default
+ * 10) until the pin/bit table is confirmed. */
+static bool ic705_in_deep_standby(void)
+{
+    uint8_t stbcr1 = 0;
+    address_space_read(&address_space_memory, 0xFCFE0020, MEMTXATTRS_UNSPECIFIED, &stbcr1, 1);
+    return (stbcr1 & 0xC0) == 0xC0 && CPU(ic705_a9)->halted;
+}
+
+static void ic705_deep_standby_wake(int factor_bit)
+{
+    uint8_t zero = 0;
+    uint16_t dsfr = 1u << factor_bit;
+    rza1h_debug("dstby", "deep standby cancel: factor bit %d -> reset A9", factor_bit);
+    address_space_write(&address_space_memory, 0xFCFE0020, MEMTXATTRS_UNSPECIFIED, &zero, 1);
+    rza1h_cpu_reset(ic705_a9);
+    address_space_write(&address_space_memory, 0xFCFF1808, MEMTXATTRS_UNSPECIFIED, &dsfr, 2);
+}
+
+/* RZ P7_11 (ARM transmit request, active low) -> sub-CPU PC13 (EXTI13, also wakes it
+ * from STOP) [ARM 0x20120960, sub 0x080039EC];
+ * RZ P5_3 (ARM receive request, active low) -> sub-CPU PB5 [ARM 0x20120C20 PSR5,
+ * sub 0x08003F48] */
+/* IC-705 touch panel: TSC2046/ADS7843-class serial touch ADC, bit-banged on port 3
+ * [FW: task 0x2008F5C4, transfer 0x2008E524, waveforms 0x202E55BC, pen poll 0x2008D830]:
+ * P3_10 /CS, P3_4 DCLK, P3_5 DIN (out), P3_6 DOUT (in), P3_11 BUSY (in), P3_12 /PENIRQ (in).
+ * Commands 0xD0 (X) and 0x90 (Y), 12-bit. BUSY rises after the 8th DCLK falling edge and
+ * drops after the 9th; data MSB first from then on, shifted on falling edges. */
+static struct {
+    bool cs, clk, din, down;
+    int n;
+    uint8_t cmd;
+    uint16_t x, y, sh;
+} ic705_tsc = { .cs = true };
+
+static void ic705_tsc_set_dout(void)
+{
+    rza1h_gpio_set_input(ic705_gpio, 3, 6, (ic705_tsc.sh >> 11) & 1);
+}
+
+static void ic705_tsc_pin(int bit, int level)
+{
+    if (bit == 10) {
+        ic705_tsc.cs = level;
+        ic705_tsc.n = 0;
+        ic705_tsc.cmd = 0;
+        rza1h_gpio_set_input(ic705_gpio, 3, 11, 0);
+        return;
+    }
+    if (bit == 5) {
+        ic705_tsc.din = level;
+        return;
+    }
+    if (bit != 4 || ic705_tsc.cs || level == ic705_tsc.clk) {
+        ic705_tsc.clk = (bit == 4) ? level : ic705_tsc.clk;
+        return;
+    }
+    ic705_tsc.clk = level;
+    if (level) {                                    /* rising edge: sample DIN */
+        if (++ic705_tsc.n <= 8) {
+            ic705_tsc.cmd = (ic705_tsc.cmd << 1) | ic705_tsc.din;
+        }
+        return;
+    }
+    if (ic705_tsc.n == 8) {                         /* falling edge */
+        int a = (ic705_tsc.cmd >> 4) & 7;
+        uint16_t v = !ic705_tsc.down ? 0 : a == 5 ? ic705_tsc.x : a == 1 ? ic705_tsc.y : 0;
+        ic705_tsc.sh = v & 0xFFF;
+        rza1h_gpio_set_input(ic705_gpio, 3, 11, 1);
+        rza1h_debug("tsc", "cmd %02x -> %03x", ic705_tsc.cmd, ic705_tsc.sh);
+    } else if (ic705_tsc.n == 9) {
+        rza1h_gpio_set_input(ic705_gpio, 3, 11, 0);
+        ic705_tsc_set_dout();
+    } else if (ic705_tsc.n > 9) {
+        ic705_tsc.sh <<= 1;
+        ic705_tsc_set_dout();
+    }
+}
+
+/* QOM machine property "touch": "X,Y" (raw 12-bit panel values) = pen down, "" = up. */
+static void ic705_set_touch(Object *obj, const char *str, Error **errp)
+{
+    unsigned x, y;
+    if (str && sscanf(str, "%u,%u", &x, &y) == 2) {
+        ic705_tsc.x = x & 0xFFF;
+        ic705_tsc.y = y & 0xFFF;
+        ic705_tsc.down = true;
+    } else {
+        ic705_tsc.down = false;
+    }
+    rza1h_gpio_set_input(ic705_gpio, 3, 12, !ic705_tsc.down);
+    rza1h_debug("tsc", "touch %s", ic705_tsc.down ? str : "up");
+}
+
+static char *ic705_get_touch(Object *obj, Error **errp)
+{
+    return ic705_tsc.down ? g_strdup_printf("%u,%u", ic705_tsc.x, ic705_tsc.y) : g_strdup("");
+}
+
+/* IC-705 settings EEPROM, bit-banged read path [FW 0x2005E3D8 -> 0x2005E2DC]: the firmware
+ * writes through RIIC0 but reads by bit-banging I2C on the same pins: SCL = P1_0 (PSR1),
+ * SDA = P1_1 open-drain (PMSR1: input = released, output = low), read back on PPR1 bit 1.
+ * Device byte 0xA0 | A17<<2 | A16<<1 | R/W, two word-address bytes, as on the RIIC path
+ * (shared image, m24m02.c). */
+static struct {
+    bool scl_lat, scl_in, sda_lat, sda_in;   /* P1 latch bits / PM1 input bits */
+    bool scl, sda_m, slave;                 /* current SCL, master SDA, slave SDA drive */
+    enum { EE_IDLE, EE_ADDR, EE_AH, EE_AL, EE_WR, EE_RD, EE_WAIT } st;
+    int bit;
+    uint8_t sh;
+    uint32_t addr;
+    bool ack_phase;     /* slave drives ACK this clock */
+    bool mack;          /* master ACK/NACK clock after a data byte we sent */
+} ic705_ee = { .scl_in = true, .sda_in = true, .scl = true, .sda_m = true, .slave = true };
+
+static void ic705_ee_drive(void)
+{
+    rza1h_gpio_set_input(ic705_gpio, 1, 1, ic705_ee.sda_m && ic705_ee.slave);
+    rza1h_gpio_set_input(ic705_gpio, 1, 0, ic705_ee.scl);
+}
+
+static void ic705_ee_rd_load(void)
+{
+    rza1h_debug("eebb", "rd %05x = %02x", ic705_ee.addr, rza1h_m24m02_read(ic705_ee.addr));
+    ic705_ee.sh = rza1h_m24m02_read(ic705_ee.addr);
+    ic705_ee.addr = (ic705_ee.addr + 1) & 0x3FFFF;
+    ic705_ee.bit = 0;
+}
+
+static void ic705_ee_update(void)
+{
+    bool scl = ic705_ee.scl_in ? true : ic705_ee.scl_lat;
+    bool sda = ic705_ee.sda_in ? true : ic705_ee.sda_lat;
+    bool pscl = ic705_ee.scl, psda = ic705_ee.sda_m;
+
+    ic705_ee.scl = scl;
+    ic705_ee.sda_m = sda;
+    if (pscl && scl && psda != sda) {
+        if (!sda) {                                 /* START / repeated START */
+            ic705_ee.st = EE_ADDR;
+            ic705_ee.bit = 0;
+            ic705_ee.sh = 0;
+            ic705_ee.ack_phase = false;
+            ic705_ee.mack = false;
+        } else {                                    /* STOP */
+            ic705_ee.st = EE_IDLE;
+        }
+        ic705_ee.slave = true;
+        ic705_ee_drive();
+        return;
+    }
+    if (!pscl && scl) {                             /* SCL rising: sample */
+        if (ic705_ee.st == EE_RD) {
+            if (ic705_ee.mack && sda) {
+                ic705_ee.st = EE_WAIT;              /* master NACK: end of read */
+            }
+        } else if (ic705_ee.st != EE_IDLE && ic705_ee.st != EE_WAIT && !ic705_ee.ack_phase) {
+            ic705_ee.sh = (ic705_ee.sh << 1) | sda;
+            ic705_ee.bit++;
+        }
+    } else if (pscl && !scl) {                      /* SCL falling: drive */
+        if (ic705_ee.st == EE_RD) {
+            if (ic705_ee.ack_phase || ic705_ee.mack) {  /* an ACK clock is over: next byte */
+                ic705_ee.ack_phase = false;
+                ic705_ee.mack = false;
+                ic705_ee_rd_load();
+            }
+            if (ic705_ee.bit < 8) {
+                ic705_ee.slave = (ic705_ee.sh >> (7 - ic705_ee.bit)) & 1;
+                ic705_ee.bit++;
+            } else {
+                ic705_ee.slave = true;              /* release for the master's ACK */
+                ic705_ee.mack = true;
+            }
+        } else if (ic705_ee.ack_phase) {            /* our ACK clock over */
+            ic705_ee.ack_phase = false;
+            ic705_ee.slave = true;
+            if (ic705_ee.st == EE_RD) {
+                ic705_ee_rd_load();
+                ic705_ee.slave = (ic705_ee.sh >> 7) & 1;
+                ic705_ee.bit = 1;
+            }
+        } else if (ic705_ee.bit == 8 && ic705_ee.st != EE_IDLE && ic705_ee.st != EE_WAIT) {
+            uint8_t b = ic705_ee.sh;
+            bool ack = true;
+            rza1h_debug("eebb", "st %d byte %02x addr %05x", ic705_ee.st, b, ic705_ee.addr);
+            ic705_ee.bit = 0;
+            ic705_ee.sh = 0;
+            switch (ic705_ee.st) {
+            case EE_ADDR:
+                if ((b & 0xF0) != 0xA0) {
+                    ack = false;
+                    ic705_ee.st = EE_WAIT;
+                    break;
+                }
+                ic705_ee.addr = (((b >> 1) & 3) << 16) | (ic705_ee.addr & 0xFFFF);
+                ic705_ee.st = (b & 1) ? EE_RD : EE_AH;
+                break;
+            case EE_AH:
+                ic705_ee.addr = (ic705_ee.addr & 0x30000) | (b << 8);
+                ic705_ee.st = EE_AL;
+                break;
+            case EE_AL:
+                ic705_ee.addr |= b;
+                ic705_ee.st = EE_WR;
+                break;
+            case EE_WR:
+                rza1h_m24m02_write(ic705_ee.addr, b);
+                ic705_ee.addr = (ic705_ee.addr & ~0xFFu) | ((ic705_ee.addr + 1) & 0xFF);
+                break;
+            default:
+                break;
+            }
+            ic705_ee.slave = !ack;
+            ic705_ee.ack_phase = ack;
+            if (ack && ic705_ee.st == EE_RD) {
+                /* ACK of a read address: first data bit goes out after this ACK clock */
+            }
+        }
+    }
+    ic705_ee_drive();
+}
+
+static void ic705_pm_hook(int port, int bit, int input)
+{
+    if (port == 1 && bit <= 1) {
+        if (bit == 0) {
+            ic705_ee.scl_in = input;
+        } else {
+            ic705_ee.sda_in = input;
+        }
+        ic705_ee_update();
+    }
+}
+
+/* IC-705 window input (GTK console): mouse = touch panel, wheel/arrows = main dial, keys =
+ * front-panel ladder keys through the sub-CPU ADC (held while held), P = POWER.
+ * Pixel -> raw panel value uses the firmware's default calibration, measured in the VM:
+ * raw 500/3500 -> X 443/52 px, Y 259/12 px (both axes inverted). */
+static int ic705_mouse_x, ic705_mouse_y;
+static bool ic705_mouse_down;
+static void ic705_pin_hook(int port, int bit, int level);
+
+static void ic705_touch_update(void)
+{
+    char buf[32];
+    if (ic705_mouse_down) {
+        int rx = 500 + (int)((443 - ic705_mouse_x) / 0.130333);
+        int ry = 500 + (int)((259 - ic705_mouse_y) / 0.082167);
+        snprintf(buf, sizeof(buf), "%d,%d", MIN(MAX(rx, 0), 4095), MIN(MAX(ry, 0), 4095));
+        ic705_set_touch(NULL, buf, NULL);
+    } else {
+        ic705_set_touch(NULL, "", NULL);
+    }
+}
+
+typedef struct { unsigned code; int8_t ch, level; } Ic705Key;
+static const Ic705Key ic705_keys[] = {
+    { KEY_M, 1, 1 }, { KEY_F, 14, 1 }, { KEY_S, 14, 2 }, { KEY_Q, 14, 3 },
+    { KEY_X, 14, 4 }, { KEY_ESC, 14, 4 }, { KEY_K, 0, 2 }, { KEY_A, 1, 2 },
+    { KEY_R, 0, 3 }, { KEY_L, 15, 1 }, { KEY_U, 15, 3 }, { KEY_D, 15, 4 },
+    { KEY_1, 0, 1 }, { KEY_2, 1, 3 }, { KEY_3, 1, 4 },
+};
+static const uint16_t ic705_ladder[5] = { 0xFFF, 0x0C0, 0x400, 0x800, 0xC00 };
+
+static void ic705_dial(int n)
+{
+    Object *m = object_resolve_path("/machine/mtu2", NULL);
+    if (m) {
+        object_property_set_int(m, "dial", n, NULL);
+    }
+}
+
+static void ic705_input_event(DeviceState *dev, QemuConsole *src, QemuInputEvent *evt)
+{
+    if (evt->type == INPUT_EVENT_KIND_ABS) {
