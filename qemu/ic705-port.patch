diff --git a/qemu-machine/src/rspi_gen.c b/qemu-machine/src/rspi_gen.c
new file mode 100644
index 0000000..3c89819
--- /dev/null
+++ b/qemu-machine/src/rspi_gen.c
@@ -0,0 +1,365 @@
+/*
+ * RZ/A1H RSPI (channels 0..4) -- generic register model, written for the IC-705 port.
+ *
+ * rspi2.c models RSPI2 around the IC-7300 fake FPGA. The IC-705 talks to SPI devices on
+ * RSPI0/1/3/4 (and polls RSPI0 SPSR during bring-up), so this device models the master
+ * itself: every byte written to SPDR is clocked out at once and the attached device's
+ * reply byte is queued in the RX FIFO. The default device answers 0xFF (an idle MISO
+ * line); RZA1H_RSPI<n>_MISO=0xNN overrides the idle byte per channel.
+ *
+ * Registers (offsets per RZ/A1H manual): SPCR +0 (SPRIE b7, SPE b6, SPTIE b5),
+ * SPSR +3 (SPRF b7, TEND b6, SPTEF b5), SPDR +4 (8/16/32-bit access = 1/2/4 frames),
+ * SPBFCR +0x20 (TXRST b7, RXRST b6), SPBFDR +0x22 (T count b11..8, R count b5..0).
+ * Interrupts: SPEI/SPRI/SPTI = GIC 270/271/272 + 3*ch.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "hw/core/qdev-properties.h"
+#include "rz_a1h.h"
+#include "rza1h_debug.h"
+#include <sys/socket.h>
+#include <sys/un.h>
+
+#define SPCR 0x00
+#define SPSR 0x03
+#define SPDR 0x04
+#define SPBFCR 0x20
+#define SPBFDR 0x22
+#define SPCR_SPRIE 0x80
+#define SPCR_SPE 0x40
+#define SPCR_SPTIE 0x20
+#define SPSR_SPRF 0x80
+#define SPSR_TEND 0x40
+#define SPSR_SPTEF 0x20
+#define RXQ 64
+
+OBJECT_DECLARE_SIMPLE_TYPE(RZA1HRspiGState, RZA1H_RSPI_GEN)
+
+struct RZA1HRspiGState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint32_t channel;
+    uint8_t regs[0x100];
+    uint8_t rx[RXQ];
+    int rx_n;
+    /* optional SPI-NOR flash on this channel (RZA1H_RSPI<n>_FLASH=path): the IC-705's
+     * DSP/FPGA configuration flash sits on RSPI4 [FW 0x2006A218: 16 MiB]. A transaction
+     * is framed by SPCR.SPE 0->1 ... 1->0 (0x20069F30 / 0x2006A0CC). */
+    uint8_t *nor;
+    uint32_t nor_size;
+    uint8_t cmd;
+    int idx;
+    uint32_t addr;
+    bool wel;
+    qemu_irq irq_rx, irq_tx;
+    /* RZA1H_RSPI<n>_SOCK=path: the attached device is an external process on a Unix
+     * socket; each clocked byte is sent as (flags, byte) -- flags bit 0 = first byte since
+     * the last SPCR write, i.e. a new chip-select frame -- and (reply byte, line state) read
+     * back (blocking). Line state bit 7 set = drive the input pin named by
+     * RZA1H_RSPI<n>_SOCK_PIN=port_bit to bit 0 (the device's handshake output). The IC-705
+     * main DSP (tools/dsp_bridge.py, ADSP-21478 simulator) sits on RSPI3 with its FLAG2 on
+     * P7_6. */
+    int sock;
+    bool frame_start;
+    int pin_port, pin_bit;
+    bool dma_rx;     /* an RX DMA from SPDR is armed: it takes the bytes, SPRI stays quiet */
+};
+
+static uint8_t nor_byte(RZA1HRspiGState *s, uint8_t tx)
+{
+    int i = s->idx++;
+    if (i == 0) {
+        s->cmd = tx;
+        s->addr = 0;
+        if (tx == 0x06) {
+            s->wel = true;
+        } else if (tx == 0x04) {
+            s->wel = false;
+        }
+        return 0xFF;
+    }
+    switch (s->cmd) {
+    case 0x05:                                  /* RDSR: never busy */
+        return s->wel ? 0x02 : 0x00;
+    case 0x9F: {                                /* RDID: IS25LP128 */
+        static const uint8_t id[3] = { 0x9D, 0x60, 0x18 };
+        return i <= 3 ? id[i - 1] : 0xFF;
+    }
+    case 0x03: case 0x0B: case 0x02: case 0xD8: case 0x20:
+        if (i <= 3) {
+            s->addr = (s->addr << 8) | tx;
+            if (i == 3 && (s->cmd == 0xD8 || s->cmd == 0x20) && s->wel) {
+                uint32_t sz = s->cmd == 0xD8 ? 0x10000 : 0x1000;
+                uint32_t a = (s->addr % s->nor_size) & ~(sz - 1);
+                memset(s->nor + a, 0xFF, MIN(sz, s->nor_size - a));
+                s->wel = false;
+                rza1h_debug("rspi", "rspi%u nor erase %#x (%#x)", s->channel, a, sz);
+            }
+            return 0xFF;
+        }
+        if (s->cmd == 0x0B && i == 4) {
+            return 0xFF;                        /* fast-read dummy byte */
+        }
+        if (s->cmd == 0x02) {
+            if (s->wel) {
+                uint32_t a = (s->addr & ~0xFFu) | ((s->addr + (i - 4)) & 0xFF);
+                s->nor[a % s->nor_size] &= tx;
+            }
+            return 0xFF;
+        }
+        if (s->cmd == 0x03 || s->cmd == 0x0B) {
+            return s->nor[s->addr++ % s->nor_size];
+        }
+        return 0xFF;
+    case 0xC7: case 0x60:
+        return 0xFF;
+    default:
+        return 0xFF;
+    }
+}
+
+static void nor_end(RZA1HRspiGState *s)
+{
+    if (s->idx > 0) {
+        if (s->cmd == 0x02) {
+            s->wel = false;
+        } else if ((s->cmd == 0xC7 || s->cmd == 0x60) && s->wel) {
+            memset(s->nor, 0xFF, s->nor_size);
+            s->wel = false;
+        }
+        rza1h_debug("rspi", "rspi%u nor cmd %02x addr %#x (%d bytes)", s->channel, s->cmd,
+                    s->addr, s->idx);
+    }
+    s->idx = 0;
+}
+
+static uint8_t dev_reply(RZA1HRspiGState *s, uint8_t tx)
+{
+    char name[24];
+    if (s->nor) {
+        return nor_byte(s, tx);
+    }
+    if (s->sock >= 0) {
+        uint8_t rb[2] = { 0xFF, 0 };
+        uint8_t msg[2] = { s->frame_start ? 1 : 0, tx };
+        s->frame_start = false;
+        if (write(s->sock, msg, 2) != 2 || read(s->sock, rb, 2) != 2) {
+            rza1h_debug("rspi", "rspi%u: socket link lost", s->channel);
+            close(s->sock);
+            s->sock = -1;
+            return 0xFF;
+        }
+        if ((rb[1] & 0x80) && s->pin_port >= 0) {
+            Object *g = object_resolve_path("/machine/gpio", NULL);
+            if (g) {
+                rza1h_gpio_set_input(DEVICE(g), s->pin_port, s->pin_bit, rb[1] & 1);
+            }
+        }
+        return rb[0];
+    }
+    snprintf(name, sizeof(name), "RZA1H_RSPI%u_MISO", s->channel);
+    const char *e = getenv(name);
+    return e ? strtoul(e, NULL, 0) : 0xFF;
+}
+
+/* SPBFCR.RXTRG (bits 2..0): receive-buffer fill that raises SPRI (1, 2, 4, 8, 16, 24, 32
+ * frames). The IC-705 sets 4 on RSPI3 (0x32, FW 0x20119304) so its receive ISR runs once per
+ * 4-byte DSP word. */
+static int rx_trigger(RZA1HRspiGState *s)
+{
+    static const int lv[8] = { 1, 2, 4, 8, 16, 24, 32, 32 };
+    return lv[s->regs[SPBFCR] & 7];
+}
+
+static RZA1HRspiGState *rspi_by_ch[5];
+
+static void update(RZA1HRspiGState *s)
+{
+    uint8_t cr = s->regs[SPCR];
+    qemu_set_irq(s->irq_rx, (cr & SPCR_SPRIE) && !s->dma_rx && s->rx_n >= rx_trigger(s));
+    qemu_set_irq(s->irq_tx, (cr & SPCR_SPTIE) && (cr & SPCR_SPE));
+}
+
+/* dmac.c: an RX DMA reading SPDR of channel ch is armed (true) / done (false). On the
+ * real chip the DMA answers the receive-full request at once, so the CPU's SPRI handler
+ * never sees those bytes (IC-705 RSPI0: the ARM's poll ISR 0x201FFA44 would otherwise
+ * steal the first byte of a DMA'd DV-DSP packet). */
+void rza1h_rspi_dma_rx(int ch, bool on)
+{
+    if (ch >= 0 && ch < 5 && rspi_by_ch[ch]) {
+        rspi_by_ch[ch]->dma_rx = on;
+        update(rspi_by_ch[ch]);
+    }
+}
+
+static uint64_t rg_read(void *opaque, hwaddr off, unsigned size)
+{
+    RZA1HRspiGState *s = opaque;
+    uint64_t v = 0;
+
+    switch (off) {
+    case SPSR:
+        return (s->rx_n >= rx_trigger(s) ? SPSR_SPRF : 0) | SPSR_TEND | SPSR_SPTEF |
+               (s->regs[SPSR] & 0x1f);
+    case SPDR: {
+        int n = size;               /* frames of 8 bits, LSB first */
+        for (int i = 0; i < n; i++) {
+            uint8_t b = 0xFF;
+            if (s->rx_n) {
+                b = s->rx[0];
+                memmove(s->rx, s->rx + 1, --s->rx_n);
+            }
+            v |= (uint64_t)b << (8 * (n - 1 - i));
+        }
+        update(s);
+        return v;
+    }
+    case SPBFDR:
+        return MIN(s->rx_n, 32);
+    default:
+        memcpy(&v, &s->regs[off], size);
+        return v;
+    }
+}
+
+static void rg_write(void *opaque, hwaddr off, uint64_t v, unsigned size)
+{
+    RZA1HRspiGState *s = opaque;
+
+    switch (off) {
+    case SPDR:
+        for (int i = size - 1; i >= 0; i--) {
+            uint8_t tx = v >> (8 * i);
+            uint8_t rb = dev_reply(s, tx);
+            if (s->rx_n < RXQ) {
+                s->rx[s->rx_n++] = rb;
+            }
+            rza1h_debug("rspi", "rspi%u tx %02x rx %02x", s->channel, tx, rb);
+        }
+        break;
+    case SPBFCR:
+        if (v & 0x40) {
+            s->rx_n = 0;
+        }
+        s->regs[off] = v & 0x3f;
+        break;
+    case SPSR:
+        s->regs[off] &= v;      /* error flags clear by writing 0 */
+        break;
+    case SPCR:
+        s->frame_start = true;
+        if (s->nor && (s->regs[SPCR] & SPCR_SPE) && !(v & SPCR_SPE)) {
+            nor_end(s);
+        }
+        s->regs[SPCR] = v;
+        break;
+    default:
+        memcpy(&s->regs[off], &v, size);
+        break;
+    }
+    update(s);
+}
+
+static const MemoryRegionOps rg_ops = {
+    .read = rg_read,
+    .write = rg_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void rg_reset(DeviceState *dev)
+{
+    RZA1HRspiGState *s = RZA1H_RSPI_GEN(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->rx_n = 0;
+    update(s);
+}
+
+static void rg_realize(DeviceState *dev, Error **errp)
+{
+    RZA1HRspiGState *s = RZA1H_RSPI_GEN(dev);
+    char name[32];
+    s->sock = -1;
+    s->pin_port = -1;
+    if (s->channel < 5) {
+        rspi_by_ch[s->channel] = s;
+    }
+    snprintf(name, sizeof(name), "RZA1H_RSPI%u_SOCK_PIN", s->channel);
+    const char *pp = getenv(name);
+    if (pp && sscanf(pp, "%d_%d", &s->pin_port, &s->pin_bit) != 2) {
+        s->pin_port = -1;
+    }
+    snprintf(name, sizeof(name), "RZA1H_RSPI%u_SOCK", s->channel);
+    const char *sp = getenv(name);
+    if (sp) {
+        struct sockaddr_un sa = { .sun_family = AF_UNIX };
+        int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        g_strlcpy(sa.sun_path, sp, sizeof(sa.sun_path));
+        for (int tries = 0; fd >= 0 && tries < 100; tries++) {
+            if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) == 0) {
+                s->sock = fd;
+                break;
+            }
+            g_usleep(100000);
+        }
+        if (s->sock < 0 && fd >= 0) {
+            close(fd);
+        }
+        rza1h_debug("rspi", "rspi%u: device on %s %s", s->channel, sp,
+                    s->sock >= 0 ? "connected" : "NOT connected");
+    }
+    snprintf(name, sizeof(name), "RZA1H_RSPI%u_FLASH", s->channel);
+    const char *path = getenv(name);
+    if (path) {
+        gsize len = 0;
+        gchar *data = NULL;
+        s->nor_size = 0x1000000;
+        s->nor = g_malloc(s->nor_size);
+        memset(s->nor, 0xFF, s->nor_size);
+        if (g_file_get_contents(path, &data, &len, NULL)) {
+            memcpy(s->nor, data, MIN(len, s->nor_size));
+            g_free(data);
+        }
+        rza1h_debug("rspi", "rspi%u: SPI-NOR from %s (%zu bytes)", s->channel, path, (size_t)len);
+    }
+}
+
+static void rg_init(Object *obj)
+{
+    RZA1HRspiGState *s = RZA1H_RSPI_GEN(obj);
+    memory_region_init_io(&s->iomem, obj, &rg_ops, s, "rza1h-rspi-gen", 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_rx);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq_tx);
+}
+
+static const Property rg_props[] = {
+    DEFINE_PROP_UINT32("channel", RZA1HRspiGState, channel, 0),
+};
+
+static void rg_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    device_class_set_legacy_reset(dc, rg_reset);
+    device_class_set_props(dc, rg_props);
+    dc->realize = rg_realize;
+}
+
+static const TypeInfo rg_info = {
+    .name = TYPE_RZA1H_RSPI_GEN,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RZA1HRspiGState),
+    .instance_init = rg_init,
+    .class_init = rg_class_init,
+};
+
+static void rg_register(void)
+{
+    type_register_static(&rg_info);
+}
+
+type_init(rg_register)
