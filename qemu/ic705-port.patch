+/* ---- IC-705 port: injected RX bytes ------------------------------------------------- */
+static void rza1h_scif_inj_load(RZA1HScifState *s)
+{
+    if (!s->rx_pending && s->inj_head != s->inj_tail && (s->scr & SCR_RE)) {
+        s->frdr = s->inj_q[s->inj_tail];
+        s->inj_tail = (s->inj_tail + 1) % (int)sizeof(s->inj_q);
+        s->rx_pending = true;
+        if (s->scr & SCR_RIE) {
+            qemu_irq_lower(s->irq_rx);
+            qemu_irq_raise(s->irq_rx);
+        }
+    }
+}
+
+static void rza1h_scif_inj_push(RZA1HScifState *s, const uint8_t *b, int n)
+{
+    for (int i = 0; i < n; i++) {
+        int nh = (s->inj_head + 1) % (int)sizeof(s->inj_q);
+        if (nh == s->inj_tail) {
+            break;
+        }
+        s->inj_q[s->inj_head] = b[i];
+        s->inj_head = nh;
+    }
+    rza1h_scif_inj_load(s);
+}
